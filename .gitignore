node_modules/
dist/
.astro/
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
.env.local
.DS_Store
*.tsbuildinfo
backups/

# `.mica/schema.json` is NOT ignored. It is build output, but it is also how the
# content model reaches Mica: the Astro build writes it, and Mica reads it back
# out of the repository.
.vercel

# Local scratch space for tooling.
.tmp/

# Rush working files. The lockfile is NOT here: it lives at
# common/config/rush/pnpm-lock.yaml and is committed, as are the
# autoinstaller lockfiles and the scripts under common/scripts/.
common/temp/
common/deploy/
common/autoinstallers/*/.npmrc
**/.rush/temp/
rush-logs/

# API Extractor working files; the reports in api/ are committed.
packages/*/temp/

# The website that tests/preview/prepare-site.mjs makes for the preview test stack.
tests/preview/site/
