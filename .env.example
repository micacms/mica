# Mica CMS — deployment configuration for docker compose.
#
#   cp .env.example .env
#   docker compose up -d
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------- required
# Public origin of the CMS. Cookies, the Origin check and the media URLs
# written into the content API all derive from this — it must match the address
# editors actually use, including https.
CMS_BASE_URL=https://cms.example.com

# The project's compiled content model. The image ships without one and refuses
# to start in production until this points at a readable file.
#
#   pnpm build:schema     # mica.config.ts -> mica.config.json
#
# docker-compose.yml already mounts that file at the path below, so leave this
# alone unless you mount it somewhere else.
MICA_SCHEMA=/app/schema.json

# Signs session cookies. Rotating it signs everyone out.
SESSION_SECRET=

# Bearer token the website build presents to the read-only content API.
# The same value goes into your CI as CMS_READ_TOKEN.
CMS_READ_TOKEN=

# ---------------------------------------------------------------- publishing
# Where to POST when content is published. Any CI system will do; the CMS does
# not know or care which. Leave empty to disable automatic rebuilds — editors
# can still trigger one from the dashboard.
BUILD_WEBHOOK_URL=
BUILD_WEBHOOK_SECRET=
PUBLISH_DEBOUNCE_MS=10000

# ---------------------------------------------------------------- optional
LOG_LEVEL=info
MAX_UPLOAD_BYTES=26214400

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=72

# Set to true ONLY when a trusted reverse proxy sets X-Forwarded-For.
# Enabling it without one lets clients spoof their address and evade rate limits.
TRUST_PROXY=true
