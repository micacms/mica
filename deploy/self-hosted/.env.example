# Mica — a self-hosted deployment.
#
# This is the file compose.yml reads. Copy it to `.env` beside the compose
# file and fill in the four blocks below; everything else has a working
# default.
#
# Every variable, with its default: https://micacms.com/docs/configuration/

# ---------------------------------------------------------------- required
# The public address of the CMS: an origin, exactly what the browser shows,
# with no path. It decides the cookie scope, the Origin check and the OIDC
# redirect. It must be https://, except http://localhost for a trial.
MICA_PUBLIC_URL=https://cms.example.com

# Encrypts the session cookie. Required; changing it signs everybody out.
# Generate one with:  openssl rand -base64 48
# Or set MICA_SESSION_SECRET_FILE to a file that holds it, such as a Docker secret.
MICA_SESSION_SECRET=

# ------------------------------------------------- the content repository
# Mica keeps a clone of a repository you already own, on its data volume.
# Saves are drafts in that clone; an editor's Publish commits them and pushes
# one commit. Any Git host over HTTPS should work; github.com and gitlab.com
# are tested every week.
#
# Before the first start: build the site once, commit the content root with
# its .mica/schema.json, push it to MICA_REPOSITORY_BRANCH, then run
#   docker compose run --rm mica check
#
# The content root is the directory with the .mica/schema.json. It is a real
# boundary: Mica writes only below it, so a token with access to the whole
# repository still cannot change the website's source, its CI configuration or
# its dependencies through Mica.

# The HTTPS clone URL, without credentials.
MICA_REPOSITORY_URL=https://github.com/acme/website.git
# The token is the password for Git over HTTPS. Mica gives it only to this
# host, and never writes it into the clone.
#
#   github.com — a fine-grained personal access token for this one
#     repository, with Contents: read and write. Nothing else.
#   gitlab.com — a project access token with read_repository and
#     write_repository, and a role that may push to the branch: Maintainer
#     when the branch is protected (GitLab protects the default branch).
# Or set MICA_REPOSITORY_TOKEN_FILE to a file that holds it: Mica reads it for
# each Git call, so a short-lived token can change without a restart.
MICA_REPOSITORY_TOKEN=
MICA_REPOSITORY_BRANCH=main
# Only when the repository has more than one .mica/schema.json: the content root to edit.
# MICA_CONTENT_PATH=content
# Defaults by host: x-access-token (GitHub), oauth2 (GitLab), mica elsewhere.
# MICA_REPOSITORY_USERNAME=
# How often Mica fetches the branch, in seconds.
# MICA_REPOSITORY_SYNC_SECONDS=60

# ------------------------------------------------------- authentication
# Mica implements no passwords, no reset flow, no MFA and no passkeys. It asks
# an OpenID Connect provider who you are. Any provider works: ZITADEL,
# Keycloak, Authentik, Entra ID, Okta, Auth0, Google Workspace.
#
# Register this redirect URI with the provider:
#   ${MICA_PUBLIC_URL}/api/auth/callback
MICA_OIDC_ISSUER=https://auth.example.com
MICA_OIDC_CLIENT_ID=mica
MICA_OIDC_CLIENT_SECRET=                 # omit for a public PKCE client

# ----------------------------------------------------------- who may edit
# Authentication is not admission. Your provider vouches for everybody it
# knows, and nothing in a valid token says the holder may edit this website —
# so at least one rule below is required, and Mica refuses to start without
# one. There is no user administration in Mica, and no invitation screen: this
# is where editors are added and removed.
#
# A — a group your provider already manages. The normal choice: adding an
#     editor is a change there, and Mica is not touched.
MICA_ADMIT_GROUPS=mica-editors
# Which claim carries it. Keycloak and Entra normally send `groups`.
# MICA_OIDC_GROUPS_CLAIM=groups
#
# B — every address in a domain, and only where the provider says it verified
#     the address.
#     Public providers such as gmail.com are refused.
# MICA_ADMIT_DOMAINS=example.com
#
# C — these addresses, only where the provider says it verified them. The
#     choice for Google accounts, which carry no groups.
# MICA_ADMIT_EMAILS=alice@gmail.com,bob@example.com
#
# D — an explicit list, keyed by `issuer|subject`. The strictest: a subject is
#     never reassigned, an address can be.
# MICA_ADMIT_SUBJECTS=https://auth.example.com|a1b2c3

# ------------------------------------------------------- reverse proxy
# Read the client IP from X-Forwarded-For. Enable ONLY behind a proxy you
# control — otherwise clients can spoof their address and walk past the login
# rate limit.
MICA_TRUST_PROXY=true

# ---------------------------------------------------------------- optional
MICA_LOG_LEVEL=info

# Deliberately short: a group removed at the provider is only seen at the next
# sign-in, so this is the upper bound on how long a removed editor keeps
# working.
MICA_SESSION_TTL_HOURS=8
MICA_SESSION_IDLE_HOURS=4
# Per file. The editor sends one file at a time, and Mica streams it to disk.
MICA_MAX_UPLOAD_BYTES=26214400
MICA_SIGNIN_MAX_ATTEMPTS=10
MICA_SIGNIN_WINDOW_MINUTES=15

# ------------------------------------------------------------------ agents
# Coding agents connect at ${MICA_PUBLIC_URL}/mcp over the Model Context
# Protocol. Each person signs in as for the editor and allows each agent on a
# consent page. An agent's access ends with MICA_SESSION_TTL_HOURS.
# MICA_MCP=true
# Agents save drafts, and people publish them. true lets a person also allow
# an agent to publish.
# MICA_MCP_PUBLISH=false
