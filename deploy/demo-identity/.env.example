# The one thing this demo cannot make up for you: a content repository.
#
# Copy to deploy/demo-identity/.env and fill in. Compose reads it automatically.
#
# The repository needs a committed content model at
# <MICA_REPOSITORY_ROOT>/.mica/schema.json — your Astro build writes it. To try Mica
# without a project of your own, push the example content to a scratch
# repository:
#
#   gh repo create mica-demo --private
#   git clone git@github.com:<you>/mica-demo.git && cd mica-demo
#   cp -a <mica>/examples/muster-consulting/content content
#   git add content && git commit -m "Seed content" && git push

# The HTTPS clone URL, without credentials.
MICA_REPOSITORY_URL=https://github.com/you/mica-demo.git

# The token is the password for Git over HTTPS.
#   github.com — a fine-grained personal access token for this one repository,
#     with Contents: read and write. Nothing else.
#   gitlab.com — a project access token with read_repository and
#     write_repository, and a role that may push to the branch: Maintainer
#     when the branch is protected (GitLab protects the default branch).
MICA_REPOSITORY_TOKEN=

# Where content lives inside the repository, and the branch to publish to.
MICA_REPOSITORY_ROOT=content
MICA_REPOSITORY_BRANCH=main
