# The one thing this demo cannot make up for you: a content repository.
#
# Copy to deploy/demo-identity/.env and fill in. Compose reads it automatically.
#
# The repository needs a committed content model at
# <REPOSITORY_ROOT>/.mica/schema.json — your Astro build writes it. To try Mica
# without a project of your own, push the example content to a scratch
# repository:
#
#   gh repo create mica-demo --private
#   git clone git@github.com:<you>/mica-demo.git && cd mica-demo
#   cp -a <mica>/examples/muster-consulting/content content
#   git add content && git commit -m "Seed content" && git push

# ------------------------------------------------------------ github.com
# A fine-grained personal access token, scoped to this one repository, with
# Contents: read and write. Nothing else.
REPOSITORY=github
REPOSITORY_PROJECT=you/mica-demo
REPOSITORY_TOKEN=github_pat_…

# ------------------------------------------------------------ gitlab.com
# A project access token with the api scope. write_repository is not enough:
# it covers git push, and Mica uses the REST API. Role Maintainer when the
# branch is protected (GitLab protects the default branch).
#
# REPOSITORY=gitlab
# REPOSITORY_PROJECT=you/mica-demo        # or the numeric project id
# REPOSITORY_TOKEN=glpat-…

# Where content lives inside the repository, and the branch to commit onto.
REPOSITORY_ROOT=content
REPOSITORY_BRANCH=main
