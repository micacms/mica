---
/**
 * Renders a rich-text field.
 *
 * The HTML comes from the CMS, where the editor schema restricts it to the
 * nodes and marks the field declares — so this is authored content from a
 * trusted, authenticated editor, not arbitrary user input. `.prose-cms` in
 * `global.css` carries a style for every node that schema can produce.
 */

interface Props {
  html: string | null;
  class?: string;
}

const { html, class: className } = Astro.props;
---

{html && <div class:list={["prose-cms", className]} set:html={html} />}
