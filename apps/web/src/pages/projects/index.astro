---
import PageIntro from "@/components/PageIntro.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";

const projects = await getProjects();
---

<BaseLayout title="Projects" description="A selection of our completed work.">
  <PageIntro eyebrow="Portfolio" title="Projects" lead="A selection of our completed work." />

  <div class="container-page pb-8">
    {
      projects.length === 0 ? (
        <p class="text-muted">No projects have been published yet.</p>
      ) : (
        <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project, index) => (
            <ProjectCard project={project} priority={index < 3} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
