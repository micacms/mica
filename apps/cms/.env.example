# Mica CMS — environment configuration
#
# Copy to .env and fill in. Every value below has a working default for local
# development except the two secrets, which are mandatory in production.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000

# Public origin of the CMS itself. Used for cookie scope, the Origin check and
# the media URLs written into the content API.
CMS_BASE_URL=http://localhost:4000

# Browser origins allowed to call the admin API in addition to CMS_BASE_URL.
# Needed only while running the Vite dev server; leave empty in production.
ADMIN_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- storage
# Everything persistent lives here — this is the directory to back up.
DATA_DIR=./data
# DATABASE_PATH=./data/cms.sqlite
# MEDIA_DIR=./data/media

# ---------------------------------------------------------------- secrets
# Required in production. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SESSION_SECRET signs the session cookie; changing it signs everyone out.
SESSION_SECRET=

# Bearer token the Astro build presents to the read-only content API.
CMS_READ_TOKEN=

# ---------------------------------------------------------------- sessions
SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=72

# ---------------------------------------------------------------- publishing
# Where to POST when content is published. Any CI system will do — the CMS does
# not know or care which. Leave empty to disable automatic rebuilds.
BUILD_WEBHOOK_URL=
BUILD_WEBHOOK_SECRET=
# Coalescing window, so a burst of edits triggers one build rather than ten.
PUBLISH_DEBOUNCE_MS=10000

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------- security
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# Read the client IP from X-Forwarded-For. Enable ONLY behind a trusted reverse
# proxy — otherwise clients can spoof their address and evade rate limiting.
TRUST_PROXY=false
