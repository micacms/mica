{
  "name": "@micacms/self-hosted",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "The self-hosted Mica composition: the runtime and editor UI behind an external OIDC provider, on a Git clone of the content repository that it keeps itself. What the Docker image runs.",
  "license": "MIT",
  "homepage": "https://micacms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micacms/mica.git",
    "directory": "apps/self-hosted"
  },
  "bugs": "https://github.com/micacms/mica/issues",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "self-hosted",
    "oidc"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@micacms/auth-oidc": "workspace:*",
    "@micacms/core": "workspace:*",
    "@micacms/editor-ui": "workspace:*",
    "@micacms/mcp": "workspace:*",
    "@micacms/runtime": "workspace:*",
    "hono": "^4.13.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  }
}
