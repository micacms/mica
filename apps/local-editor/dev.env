# `rush dev`: the local editor against the example, for working on Mica itself.
# The published editor reads no file; `npx @micacms/editor` sets these from its flags.
MICA_CONTENT_ROOT=../../examples/muster-consulting/content
# The Vite dev server of the editor UI calls the API from this origin.
MICA_ADMIN_ORIGINS=http://localhost:5173
