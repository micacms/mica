{
  "name": "@micacms/editor",
  "version": "0.6.0-rc.1",
  "type": "module",
  "description": "The local Mica editor — `npx @micacms/editor` against a checkout on your own machine. No authentication, no database, loopback only.",
  "license": "MIT",
  "homepage": "https://micacms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micacms/mica.git",
    "directory": "apps/local-editor"
  },
  "bugs": "https://github.com/micacms/mica/issues",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "astro",
    "git",
    "markdoc",
    "headless-cms"
  ],
  "bin": {
    "mica": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=dev.env --clear-screen=false --include ../../examples/muster-consulting/content/.mica/schema.json src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@micacms/core": "workspace:*",
    "@micacms/editor-ui": "workspace:*",
    "@micacms/runtime": "workspace:*",
    "hono": "^4.13.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
