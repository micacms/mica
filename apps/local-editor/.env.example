# The local Mica editor — environment configuration.
#
# Copy to .env and adjust. Every value has a working default for developing in
# this repository. There is no authentication section, because this app has no
# authentication: no identity provider, no session, no database, and refusals
# baked in against ever being reachable by anyone but you. A deployment runs
# @micacms/self-hosted instead — see docs/self-hosting.md.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=6422

# The address to listen on. Loopback, and the editor refuses anything else.
# HOST=127.0.0.1

# Public origin of the editor itself. Must be this machine.
MICA_PUBLIC_URL=http://localhost:6422

# Browser origins allowed to call the admin API in addition to MICA_PUBLIC_URL.
# Needed only while running the Vite dev server.
ADMIN_ORIGINS=http://localhost:5173

# ------------------------------------------------- the content directory
# The working tree this editor edits. It is also the draft workspace: a save
# is a file the Astro dev server hot-reloads, and nothing is committed until
# you publish.
CONTENT_ROOT=../../examples/muster-consulting/content

# Publish commits the reviewed content paths and pushes with your own git —
# your credentials, your remotes. Set to false to keep Publish out of the
# editor and commit entirely with your own tools.
MICA_LOCAL_PUBLISH=true

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=26214400
