{
  "realm": "mica",
  "enabled": true,
  "displayName": "Mica (end-to-end test)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "mica",
      "name": "Mica",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "e2e-client-secret-not-for-production",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:6422/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:6422"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:6422/admin/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "groups": [
        "/mica-editors"
      ]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Editor",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "groups": [
        "/mica-editors"
      ]
    },
    {
      "username": "mallory",
      "email": "mallory@example.com",
      "emailVerified": true,
      "firstName": "Mallory",
      "lastName": "Nobody",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "mallory",
          "temporary": false
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "mica-editors",
      "path": "/mica-editors"
    }
  ]
}
