/**
 * Rush drives this repository: it installs one dependency tree for every
 * project listed below, links them together, and builds them in dependency
 * order.
 *
 *   rush update   — install (after changing any package.json)
 *   rush install  — install exactly what the lockfile says (CI)
 *   rush build    — build everything that changed, in order
 *   rush test     — every project's test script
 *
 * There are no workspace globs: a new project is added by listing it in
 * `projects` below. pnpm is still the package manager underneath — Rush
 * downloads its own copy, pinned here, so nothing depends on what is
 * installed globally.
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",

  "rushVersion": "5.178.1",
  "pnpmVersion": "11.3.0",

  // Matches the `engines` field the published packages declare.
  "nodeSupportedVersionRange": ">=24.0.0 <27.0.0",

  // packages/auth/oidc sits three levels down; Rush's default limit is two.
  "projectFolderMaxDepth": 3,

  "repository": {
    "defaultBranch": "main"
  },

  "projects": [
    // ---------------------------------------------------------- packages
    // The published libraries. The `mica` version policy (see
    // common/config/rush/version-policies.json) is what publishes them, all
    // at one lockstep version. The `packages` tag is what CI builds first:
    // `rush build --to tag:packages` is the old `pnpm --filter "./packages/**" build`.
    {
      "packageName": "@micacms/core",
      "projectFolder": "packages/core",
      "versionPolicyName": "mica",
      "tags": ["packages"]
    },
    {
      "packageName": "@micacms/astro",
      "projectFolder": "packages/astro",
      "versionPolicyName": "mica",
      "tags": ["packages"]
    },
    {
      "packageName": "@micacms/editor-ui",
      "projectFolder": "packages/editor-ui",
      "tags": ["packages"]
    },
    {
      "packageName": "@micacms/runtime",
      "projectFolder": "packages/runtime",
      "versionPolicyName": "mica",
      "tags": ["packages"]
    },
    {
      "packageName": "@micacms/auth-oidc",
      "projectFolder": "packages/auth/oidc",
      "tags": ["packages"]
    },

    // -------------------------------------------------------------- apps
    {
      "packageName": "@micacms/editor",
      "projectFolder": "apps/local-editor",
      "versionPolicyName": "mica",
      "tags": ["apps"]
    },
    // Not published: it ships only as the image. No version policy, so
    // `rush publish` skips it; `scripts/version.mjs --sync` still gives it the
    // release version, which the release workflow checks against the tag.
    {
      "packageName": "@micacms/self-hosted",
      "projectFolder": "apps/self-hosted",
      "tags": ["apps"]
    },

    // ------------------------------------------------------------- sites
    // Never published: no version policy, and their manifests say
    // `"private": true` besides.
    {
      "packageName": "@micacms/site",
      "projectFolder": "sites/micacms",
      "tags": ["sites"]
    },
    {
      "packageName": "@micacms/example-company-site",
      "projectFolder": "examples/company-site",
      "tags": ["sites"]
    },

    // ------------------------------------------------------------- tests
    // Never published. Runs only against the OIDC test stack, so it has no
    // `test` script and `rush test` skips it.
    {
      "packageName": "@micacms/browser-test",
      "projectFolder": "tests/browser",
      "tags": ["tests"]
    }
  ]
}
