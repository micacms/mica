# Mica CMS — environment configuration
#
# Copy to .env and fill in. Every value below has a working default for local
# development except SESSION_SECRET, which is mandatory in production.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=6422

# The address to listen on. Defaulted per mode: 127.0.0.1 in local mode, which
# refuses anything else, and 0.0.0.0 when self-hosted, where a container has to
# bind every interface to be reachable at all.
# HOST=127.0.0.1

# Public origin of the CMS itself. Used for cookie scope and the Origin check.
MICA_PUBLIC_URL=http://localhost:6422

# Browser origins allowed to call the admin API in addition to MICA_PUBLIC_URL.
# Needed only while running the Vite dev server; leave empty in production.
ADMIN_ORIGINS=http://localhost:5173

# -------------------------------------------------------- how it is run
# local        your machine. No identity provider, NO AUTHENTICATION and no
#              user at all: there is nobody to be, and nothing to sign in to.
#              Mica refuses to start this way in production, on any host but
#              localhost, or bound to anything but the loopback address.
# self-hosted  somebody's server. OIDC in front of one site.
MICA_MODE=local

# ------------------------------------------------------- authentication
# Mica implements no passwords, no reset flow and no second factor. It asks an
# identity provider who you are. Required unless MICA_MODE=local.
#
# Register this redirect URI with the provider:
#   ${MICA_PUBLIC_URL}/api/auth/callback
#
# MICA_OIDC_ISSUER=https://auth.example.com/realms/mica
# MICA_OIDC_CLIENT_ID=mica
# MICA_OIDC_CLIENT_SECRET=               # omit for a public PKCE client
# MICA_OIDC_SCOPE=openid profile email
#
# Which claim carries the person's groups. There is no standard one: Keycloak
# and Entra normally send `groups`, others send `roles`.
# MICA_OIDC_GROUPS_CLAIM=groups

# ----------------------------------------------------------- who may edit
# Authentication is not admission. Your provider will vouch for everybody it
# knows, and nothing in a valid token says the holder may edit this website —
# so outside local mode at least one of these is required, and Mica refuses to
# start without one.
#
# The group rule is the one to grow into: adding an editor is then a change in
# the identity provider, and Mica is not touched.
#
# MICA_ADMIT_GROUP=mica-editors          comma-separated; a Keycloak path works
# MICA_ADMIT_DOMAIN=example.com          only for addresses the provider verified
# MICA_ADMIT_SUBJECTS=https://auth.example.com|a1b2c3
#
# The subject list is keyed by `issuer|subject` and never by email: providers
# let people change addresses, and two people can hold one in turn.

# ------------------------------------------------- the content repository
# Content and media are files in a Git repository. That repository is the
# source of truth for the website: it can be rebuilt from the repository
# alone, with or without this server running.
#
# REPOSITORY=local writes into a working tree on this machine. Right for
# development, and for a self-hosted deployment that has a checkout beside it
# and its own way of committing and deploying.
REPOSITORY=local
CONTENT_ROOT=../../sites/muster-consulting/content

# REPOSITORY=github or gitlab commits through the provider's API instead. No
# clone, no deploy key on disk, and every save is a reviewable commit.
#
#   REPOSITORY=github
#   REPOSITORY_PROJECT=acme/website          # owner/repo
#   REPOSITORY_TOKEN=                        # needs contents: write
#
#   REPOSITORY=gitlab
#   REPOSITORY_PROJECT=acme/website          # group/project, or a numeric id
#   REPOSITORY_TOKEN=                        # needs the write_repository scope
#
# Where the content root sits inside that repository, and which branch to
# commit onto. The token cannot reach anything outside REPOSITORY_ROOT through
# Mica, so keeping content in its own directory is worth doing.
REPOSITORY_ROOT=content
REPOSITORY_BRANCH=main
# For GitHub Enterprise Server or self-managed GitLab.
# REPOSITORY_API_BASE=https://git.example.com

# ---------------------------------------------------------------- database
# Sessions. That is the whole of it — there are no accounts, and no content is
# in here: losing this database signs everyone out and costs nothing else.
DATA_DIR=./data
# DATABASE_PATH=./data/cms.sqlite

# ---------------------------------------------------------------- secrets
# Required in production. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SESSION_SECRET signs the session cookie; changing it signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------- sessions
# Deliberately short. A group removed at the identity provider is only seen at
# the next sign-in, so this is the upper bound on how long a revoked editor
# keeps working.
SESSION_TTL_HOURS=8
SESSION_IDLE_HOURS=4

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------- security
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# Read the client IP from X-Forwarded-For. Enable ONLY behind a trusted reverse
# proxy — otherwise clients can spoof their address and evade rate limiting.
TRUST_PROXY=false
