{
  "private": true,
  "name": "@micacms/auth-oidc",
  "version": "0.8.0",
  "type": "module",
  "description": "The server-only OIDC gate for Mica: sign-in, sessions and admission around @micacms/runtime. Never enters a browser bundle, and never a dependency of the local editor.",
  "license": "MIT",
  "homepage": "https://micacms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micacms/mica.git",
    "directory": "packages/auth/oidc"
  },
  "bugs": "https://github.com/micacms/mica/issues",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "oidc",
    "authentication"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@micacms/core": "workspace:*",
    "@micacms/runtime": "workspace:*",
    "hono": "^4.13.7",
    "openid-client": "^6.8.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  }
}
