{
  "name": "@micacms/runtime",
  "version": "0.8.0",
  "type": "module",
  "description": "The Mica single-site runtime: the Hono API, application services and staging orchestration, authentication-neutral. Composed by @micacms/editor locally and @micacms/self-hosted behind OIDC.",
  "license": "MIT",
  "homepage": "https://micacms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micacms/mica.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/micacms/mica/issues",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "runtime",
    "hono"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@micacms/core": "workspace:*",
    "hono": "^4.13.7",
    "image-size": "^2.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  }
}
