{
  "name": "@micacms/connectors",
  "version": "0.2.0",
  "type": "module",
  "description": "Repository access for Mica: a narrow connector interface, with local and provider-backed implementations.",
  "license": "MIT",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "git",
    "github",
    "gitlab",
    "content"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "@micacms/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3"
  }
}
