{
  "name": "@micacms/connectors",
  "version": "1.0.0",
  "type": "module",
  "description": "Repository access for Mica: a narrow connector interface, with local and provider-backed implementations.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "@micacms/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3"
  }
}
