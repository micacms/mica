{
  "name": "@micacms/core",
  "version": "0.11.0",
  "type": "module",
  "description": "The Mica core: content model DSL, authoring format, and the port contracts every adapter implements. Single source of truth for types, validation, editor forms, the on-disk format and Astro collection schemas.",
  "license": "MIT",
  "homepage": "https://micacms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micacms/mica.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/micacms/mica/issues",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "content-model",
    "schema",
    "markdoc",
    "zod"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^4.3.6",
    "fast-check": "^4.10.2"
  }
}
