{
  "name": "@micacms/astro",
  "version": "0.16.0",
  "type": "module",
  "description": "Reads a Mica content repository as Astro Content Collections via the Content Layer API.",
  "license": "MIT",
  "homepage": "https://mica.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micacms/mica.git",
    "directory": "packages/astro"
  },
  "bugs": "https://github.com/micacms/mica/issues",
  "engines": {
    "node": ">=24"
  },
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "astro",
    "content-layer",
    "markdoc"
  ],
  "sideEffects": [
    "./components/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./relations": {
      "types": "./dist/relations.d.ts",
      "default": "./dist/relations.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    },
    "./preview/client": "./dist/preview/client.js",
    "./components": "./components/index.ts"
  },
  "files": [
    "components",
    "dist",
    "setup",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/api-report.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.9"
  },
  "peerDependencies": {
    "@micacms/core": "workspace:^",
    "astro": "^7.0.0",
    "maplibre-gl": "^6.11.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@micacms/core": "workspace:*",
    "@types/node": "^22.20.1",
    "astro": "^7.2.2",
    "maplibre-gl": "6.11.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^4.3.6",
    "@microsoft/api-extractor": "7.59.3",
    "@astrojs/compiler-rs": "^0.5.1"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  }
}
