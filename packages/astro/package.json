{
  "name": "@micacms/astro",
  "version": "0.4.0",
  "type": "module",
  "description": "Reads a Mica content repository as Astro Content Collections via the Content Layer API.",
  "license": "MIT",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "astro",
    "astro-integration",
    "content-layer",
    "markdoc"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.9",
    "@micacms/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "astro": "^7.2.2",
    "typescript": "^5.7.3"
  }
}
