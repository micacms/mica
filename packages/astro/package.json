    "test": "tsc -p tsconfig.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "@micacms/model": "workspace:*",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "astro": "^5.13.0",
    "typescript": "^5.7.3"
  }
}
