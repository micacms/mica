{
  "name": "@micacms/model",
  "version": "0.0.3",
  "type": "module",
  "description": "Content model DSL and authoring format for Mica. Single source of truth for types, validation, editor forms, the on-disk format and Astro collection schemas.",
  "license": "MIT",
  "author": "Alexander Müdespacher",
  "keywords": [
    "mica",
    "cms",
    "content-model",
    "schema",
    "markdoc",
    "zod"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3"
  }
}
