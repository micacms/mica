---
import { getEntry } from "astro:content";

interface Props {
  title?: string;
}

const settings = (await getEntry("site", "site"))?.data;
const pageTitle = Astro.props.title ? `${Astro.props.title} — ${settings?.title ?? ""}` : (settings?.title ?? "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {settings?.description && <meta name="description" content={settings.description} />}
  </head>
  <body style="max-width: 42rem; margin: 2rem auto; padding: 0 1rem; font-family: system-ui, sans-serif; line-height: 1.6;">
    <header><a href="/">{settings?.title}</a></header>
    <main><slot /></main>
  </body>
</html>
