---
/**
 * Renders a content media reference as an optimised, static image.
 *
 * The reference is a path into the content repository, so the file is on disk
 * when the build runs and `astro:assets` treats it as a local asset: it is
 * re-encoded and emitted into `_astro/`. Nothing a visitor loads points at a
 * CMS, and no origin has to be allowlisted for it to work.
 *
 * The alt text comes with the value of a `media({ alt })` field. A page that
 * shows the image as decoration, such as a card next to its title, passes
 * `alt=""` to override it.
 */

import { Image } from "astro:assets";
import type { MediaWithAlt } from "@micacms/core";

import { isVector, resolveMedia } from "@/lib/images";

interface Props {
  /** A media value, as the loader emits it: a content-root-relative path, or `{ path, alt }`. */
  media: string | MediaWithAlt | null;
  /** Overrides the value's alt text; "" for a decorative image. */
  alt?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Hint to the browser that this is the largest element above the fold. */
  priority?: boolean;
}

const {
  media,
  alt = typeof media === "object" ? (media?.alt ?? "") : "",
  class: className,
  widths,
  sizes,
  loading,
  priority = false,
} = Astro.props;

const image = resolveMedia(typeof media === "object" ? media?.path : media);
---

{
  image && !isVector(image) ? (
    <Image
      src={image}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      loading={priority ? "eager" : (loading ?? "lazy")}
      fetchpriority={priority ? "high" : undefined}
      decoding={priority ? "sync" : "async"}
    />
  ) : image ? (
    <img
      src={image.src}
      alt={alt}
      class={className}
      width={image.width || undefined}
      height={image.height || undefined}
      loading={priority ? "eager" : (loading ?? "lazy")}
      decoding="async"
    />
  ) : null
}
