---
/** Header and main menu, both driven by the `navigation` singleton. */

import CmsImage from "@/components/CmsImage.astro";
import { getNavigation, getSiteSettings } from "@/lib/content";

const settings = await getSiteSettings();
const navigation = await getNavigation();

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string): boolean => {
  const target = href.replace(/\/$/, "") || "/";
  return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="container-page flex h-16 items-center gap-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={settings.companyName}>
      {
        settings.logo ? (
          <CmsImage media={settings.logo} alt={settings.companyName} class="h-8 w-auto" widths={[96, 192]} sizes="96px" />
        ) : (
          <span class="text-base font-semibold tracking-tight">{settings.companyName}</span>
        )
      }
    </a>

    <!-- The menu is a details/summary disclosure: it opens and closes with no
         JavaScript at all, and is keyboard-operable by default. -->
    <details class="group ml-auto md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center rounded p-2 [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <svg viewBox="0 0 20 20" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round" class="group-open:hidden" />
          <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" class="hidden group-open:block" />
        </svg>
      </summary>

      <nav
        class="absolute inset-x-0 top-16 border-b border-line bg-canvas p-5 shadow-lg"
        aria-label="Main"
      >
        <ul class="space-y-1">
          {
            navigation.main.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block py-2 text-base font-medium"
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
                {item.children.length > 0 && (
                  <ul class="ml-4 space-y-1 border-l border-line pl-3">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="block py-1.5 text-sm text-muted">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <nav class="ml-auto hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-7">
        {
          navigation.main.map((item) => (
            <li class="group relative">
              <a
                href={item.href}
                class="text-sm font-medium transition hover:text-primary aria-[current=page]:text-primary"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>

              {item.children.length > 0 && (
                <ul class="invisible absolute left-0 top-full min-w-44 border border-line bg-canvas py-1.5 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-4 py-1.5 text-sm text-muted transition hover:bg-sunken hover:text-ink"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
