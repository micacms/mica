---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <div class="container-page grid min-h-[55vh] place-items-center py-20 text-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">404</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
        This page does not exist
      </h1>
      <p class="mt-3 text-muted">
        The address may be out of date, or the page may have been removed.
      </p>
      <a href="/" class="btn-solid mt-8">Back to the homepage</a>
    </div>
  </div>
</BaseLayout>
