---
import { getCollection, type CollectionEntry } from "astro:content";

import CmsImage from "@/components/CmsImage.astro";
import LocationMap from "@/components/LocationMap.astro";
import RichText from "@/components/RichText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteSettings, toPlainText } from "@/lib/content";

/**
 * Catch-all for the `pages` collection — About, Services, Contact and whatever
 * else an editor creates, at the URL they chose.
 *
 * More specific routes (`/projects`, `/news`, `/team`) win, so a page whose
 * slug collides with one of those is simply shadowed.
 */
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<"pages">;
}

const { page } = Astro.props;
const { title, intro, heroImage, body, sections, seo } = page.data;

const settings = await getSiteSettings();

// The contact page is the natural home for the company's location.
const showLocation = page.id === "contact" && settings.position !== null;

const SECTION_LAYOUTS: Record<string, string> = {
  "image-right": "lg:grid-cols-2",
  "image-left": "lg:grid-cols-2 [&>figure]:lg:order-first",
  full: "",
};
---

<BaseLayout
  title={seo?.metaTitle ?? title}
  description={seo?.metaDescription ?? intro ?? toPlainText(body)}
  image={seo?.ogImage ?? heroImage?.src}
  noindex={seo?.noindex ?? false}
>
  <div class="container-page pb-10 pt-14 sm:pt-20">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h1>
      {intro && <p class="mt-5 text-lg text-muted text-pretty">{intro}</p>}
    </div>
  </div>

  {
    heroImage && (
      <div class="container-page mb-12">
        <div class="overflow-hidden bg-sunken" style="border-radius: var(--radius-theme)">
          <CmsImage
            media={heroImage}
            class="w-full object-cover"
            widths={[800, 1200, 1800]}
            sizes="(min-width: 1152px) 1120px, 92vw"
            priority
          />
        </div>
      </div>
    )
  }

  {
    body && (
      <div class="container-prose pb-4">
        <RichText text={body} />
      </div>
    )
  }

  {
    sections.length > 0 && (
      <div class="container-page mt-16 space-y-16">
        {sections.map((section) => (
          <section
            class:list={[
              "grid items-center gap-8",
              SECTION_LAYOUTS[section.layout ?? "image-right"],
            ]}
          >
            <div>
              <h2 class="text-2xl font-semibold tracking-tight">{section.heading}</h2>
              <div class="mt-3">
                <RichText text={section.text} />
              </div>
            </div>

            {section.image && (
              <figure class="overflow-hidden bg-sunken" style="border-radius: var(--radius-theme)">
                <CmsImage
                  media={section.image}
                  class="w-full object-cover"
                  widths={[600, 1000]}
                  sizes="(min-width: 1024px) 45vw, 92vw"
                />
              </figure>
            )}
          </section>
        ))}
      </div>
    )
  }

  {
    showLocation && (
      <div class="container-page mt-14">
        <LocationMap
          position={settings.position}
          label={settings.companyName}
          address={settings.address}
          zoom={16}
        />
      </div>
    )
  }
</BaseLayout>
