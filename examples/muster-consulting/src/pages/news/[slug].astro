---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

import CmsImage from "@/components/CmsImage.astro";
import RichText from "@/components/RichText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, toPlainText } from "@/lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("news");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"news">;
}

const { article } = Astro.props;
const { title, publishDate, excerpt, coverImage, body, author } = article.data;

const writer = author ? await getEntry("team", author) : undefined;
---

<BaseLayout
  title={title}
  description={excerpt ?? toPlainText(body)}
  image={coverImage?.src}
>
  <article>
    <div class="container-prose pb-8 pt-14 sm:pt-20">
      <a href="/news/" class="text-sm text-muted hover:text-primary">← All news</a>

      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>

      <p class="mt-3 text-sm text-muted">
        {publishDate && <time datetime={publishDate}>{formatDate(publishDate)}</time>}
        {writer && <span>{publishDate ? " · " : ""}by {writer.data.name}</span>}
      </p>

      {excerpt && <p class="mt-5 text-lg text-muted text-pretty">{excerpt}</p>}
    </div>

    {
      coverImage && (
        <div class="container-page mb-10">
          <div class="overflow-hidden bg-sunken" style="border-radius: var(--radius-theme)">
            <CmsImage
              media={coverImage}
              class="w-full object-cover"
              widths={[800, 1200, 1800]}
              sizes="(min-width: 1152px) 1120px, 92vw"
              priority
            />
          </div>
        </div>
      )
    }

    <div class="container-prose pb-8">
      <RichText text={body} />
    </div>
  </article>
</BaseLayout>
