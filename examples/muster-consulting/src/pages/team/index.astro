---
import CmsImage from "@/components/CmsImage.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedTeam } from "@/lib/content";

const team = await getFeaturedTeam();
---

<BaseLayout title="Team" description="The people behind the work.">
  <PageIntro eyebrow="People" title="Team" lead="The people behind the work." />

  <div class="container-page pb-8">
    {
      team.length === 0 ? (
        <p class="text-muted">No team members have been published yet.</p>
      ) : (
        <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((member, index) => (
            <li>
              {member.data.portrait ? (
                <div
                  class="aspect-3/4 overflow-hidden bg-sunken"
                  style="border-radius: var(--radius-theme)"
                >
                  <CmsImage
                    media={member.data.portrait}
                    class="h-full w-full object-cover"
                    widths={[320, 640]}
                    sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                    priority={index < 3}
                  />
                </div>
              ) : (
                <div
                  class="flex aspect-3/4 items-center justify-center bg-sunken text-3xl font-semibold text-muted"
                  style="border-radius: var(--radius-theme)"
                  aria-hidden="true"
                >
                  {member.data.name
                    .split(" ")
                    .slice(0, 2)
                    .map((part) => part[0])
                    .join("")}
                </div>
              )}

              <h2 class="mt-4 font-semibold tracking-tight">
                {member.data.name}
              </h2>
              {member.data.role && (
                <p class="text-sm text-muted">{member.data.role}</p>
              )}
              {member.data.bio && (
                <p class="mt-2 text-sm text-muted text-pretty">
                  {member.data.bio}
                </p>
              )}

              <div class="mt-3 space-y-0.5 text-sm">
                {member.data.email && (
                  <p>
                    <a
                      href={`mailto:${member.data.email}`}
                      class="text-primary hover:underline"
                    >
                      {member.data.email}
                    </a>
                  </p>
                )}
                {member.data.phone && (
                  <p>
                    <a
                      href={`tel:${member.data.phone.replace(/\s/g, "")}`}
                      class="text-muted hover:text-primary"
                    >
                      {member.data.phone}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
