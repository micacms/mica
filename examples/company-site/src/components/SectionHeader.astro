---
/** The heading row of a homepage section, with a link to the full list. */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  href: string;
  linkLabel: string;
}

const { id, eyebrow, title, href, linkLabel } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
  <div>
    <p class="eyebrow text-accent">{eyebrow}</p>
    <h2 id={id} class="mt-2 text-3xl font-semibold sm:text-4xl">{title}</h2>
  </div>
  <a href={href} class="link-arrow">{linkLabel} <span aria-hidden="true">→</span></a>
</div>
