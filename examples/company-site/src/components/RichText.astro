---
/**
 * Renders a rich-text field.
 *
 * The field is Markdoc, and this turns it into HTML during the build. Markdoc
 * can only produce what its configuration allows — no raw HTML, and no tag that
 * has not been declared — so the output is markup this site's `.prose-cms`
 * styles cover, rather than whatever an editor's clipboard happened to contain.
 */

import { renderRichText, type RichTextImage } from "@micacms/astro";

interface Props {
  /** Markdoc source, as stored in the entry's `.mdoc` sidecar. */
  text: string | null;
  /** The entry's images, `entry.data._mica.images`, so that an image in the text has a real address. */
  images?: RichTextImage[];
  class?: string;
}

const { text, images, class: className } = Astro.props;
const html = renderRichText(text, { images });
---

{html && <div class:list={["prose-cms", className]} set:html={html} />}
