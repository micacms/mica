---
/**
 * Renders a rich-text field.
 *
 * The field is Markdoc, and this turns it into HTML during the build. Markdoc
 * can only produce what its configuration allows — no raw HTML, and no tag that
 * has not been declared — so the output is markup this site's `.prose-cms`
 * styles cover, rather than whatever an editor's clipboard happened to contain.
 */

import { renderRichText, type RichTextSource } from "@micacms/astro";

import { localePath } from "@/lib/i18n";

interface Props {
  /** Markdoc source, as stored in the entry's `.mdoc` sidecar. */
  text: string | null;
  /** The entry's or the singleton's data, so that an image in the text has its file, which Astro optimizes. */
  from?: RichTextSource | null;
  class?: string;
}

const { text, from, class: className } = Astro.props;
// Editors write one address for all languages, such as /team/: the page of a German text links to /de/team/.
const locale = Astro.currentLocale;
const html = await renderRichText(text, from, { link: (href) => localePath(href, locale) });
---

{html && <div class:list={["prose-cms", className]} set:html={html} />}
