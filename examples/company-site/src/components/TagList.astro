---
/** A row of tags. Renders nothing for an empty list. */
interface Props {
  tags: readonly string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
      {tags.map((tag) => (
        <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{tag}</li>
      ))}
    </ul>
  )
}
