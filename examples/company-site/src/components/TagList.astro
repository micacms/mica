---
/** A row of tags. Renders nothing for an empty list. */
import { getLabels } from "@/lib/content";

interface Props {
  tags: readonly string[];
}

const { tags } = Astro.props;
const { general: labels } = await getLabels(Astro.currentLocale);
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label={labels.tags}>
      {tags.map((tag) => (
        <li class="rounded-full bg-primary/6 px-2.5 py-1 text-[11px] font-semibold uppercase leading-none tracking-wider text-primary">{tag}</li>
      ))}
    </ul>
  )
}
