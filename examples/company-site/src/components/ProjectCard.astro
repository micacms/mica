---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import TagList from "@/components/TagList.astro";
import { categoryLabel, getLabels, projectPath } from "@/lib/content";

interface Props {
  project: CollectionEntry<"projects">;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { title, year, category, gallery, location, tags } = project.data;

const cover = gallery[0] ?? null;
const { projects: labels } = await getLabels();
---

<article class="group">
  <a href={projectPath(project)} class="block">
    <div class="media-frame aspect-4/3">
      {
        cover ? (
          <Image
            src={cover.src}
            alt={cover.alt}
            class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]"
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : "auto"}
          />
        ) : (
          <div class="flex h-full items-center justify-center text-sm text-muted">{labels.noImage}</div>
        )
      }
    </div>

    <div class="mt-5">
      {category && <p class="eyebrow text-accent">{categoryLabel(category)}</p>}
      <h3 class="mt-2 text-lg font-semibold leading-snug transition group-hover:text-primary">
        {title}
      </h3>
      <p class="mt-1 text-sm text-muted">
        {[location?.city, year].filter(Boolean).join(" · ")}
      </p>
    </div>
  </a>
  <div class="mt-3">
    <TagList tags={tags} />
  </div>
</article>
