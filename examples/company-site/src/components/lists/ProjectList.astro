---
/** The projects, below the content of the page with the template "List of projects". */
import ProjectCard from "@/components/ProjectCard.astro";
import { getLabels, getProjects } from "@/lib/content";

const locale = Astro.currentLocale;
const [{ projects: labels }, projects] = await Promise.all([getLabels(locale), getProjects(locale)]);
---

<div class="container-page pb-8">
  {
    projects.length === 0 ? (
      <p class="text-muted">{labels.empty}</p>
    ) : (
      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project, index) => (
          <ProjectCard project={project} priority={index < 3} />
        ))}
      </div>
    )
  }
</div>
