---
/** The events, below the content of the page with the template "List of events". */
import TagList from "@/components/TagList.astro";
import { dateBadge, formatDateTime, formatLabel, getEvents, getLabels } from "@/lib/content";
import { localePath } from "@/lib/i18n";

// Upcoming events first, then the past ones. Both lists come from one helper.
const locale = Astro.currentLocale;
const [{ events: labels }, { upcoming, past }] = await Promise.all([getLabels(locale), getEvents(locale)]);
const groups = [
  { heading: labels.upcoming, items: upcoming, empty: labels.noUpcoming },
  { heading: labels.past, items: past, empty: "" },
];
---

<div class="container-page space-y-16 pb-8">
  {
    groups.map(({ heading, items, empty }) => (
      <section>
        <h2 class="eyebrow border-b border-line pb-4 text-muted">{heading}</h2>
        {items.length === 0 ? (
          empty && <p class="mt-4 text-muted">{empty}</p>
        ) : (
          <ul class="divide-y divide-line">
            {items.map((event) => {
              const badge = dateBadge(event.data.startsAt, locale);
              return (
                <li class="grid gap-x-8 gap-y-3 py-8 sm:grid-cols-[4.5rem_1fr]">
                  {badge ? (
                    <div class="hidden w-16 flex-col items-center self-start border border-line py-2.5 text-center sm:flex" style="border-radius: var(--radius-theme)" aria-hidden="true">
                      <span class="text-[11px] font-semibold uppercase tracking-wider text-accent">{badge.month}</span>
                      <span class="text-2xl font-semibold leading-none">{badge.day}</span>
                    </div>
                  ) : (
                    <div class="hidden sm:block" />
                  )}
                  <div>
                    <a href={localePath(`/events/${event.id}/`, locale)} class="group block">
                      <time datetime={event.data.startsAt} class="text-xs font-medium text-muted">
                        {formatDateTime(event.data.startsAt, locale)}
                      </time>
                      <h3 class="mt-1.5 text-xl font-semibold group-hover:text-primary sm:text-2xl">
                        {event.data.title}
                      </h3>
                      <p class="mt-1.5 text-sm text-muted">
                        {event.data.format.map((value) => formatLabel(value, labels.formats)).join(" · ")}
                        {event.data.venue?.name ? ` · ${event.data.venue.name}` : ""}
                      </p>
                      {event.data.summary && (
                        <p class="mt-3 max-w-2xl text-muted text-pretty">{event.data.summary}</p>
                      )}
                    </a>
                    <div class="mt-4">
                      <TagList tags={event.data.tags} />
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))
  }
</div>
