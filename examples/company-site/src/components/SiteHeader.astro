---
import { Image } from "astro:assets";
/** Header, main menu and language menu. The menu is driven by the `navigation` singleton. */

import { getLabels, getNavigation, getSiteSettings } from "@/lib/content";
import { LOCALES, localeName, localePath, withoutLocale } from "@/lib/i18n";

const locale = Astro.currentLocale;
const settings = await getSiteSettings(locale);
const navigation = await getNavigation(locale);
const { general: labels } = await getLabels(locale);

// The menu's addresses are without a locale, like the editor writes them.
const path = withoutLocale(Astro.url.pathname, locale).replace(/\/$/, "") || "/";
const isCurrent = (href: string): boolean => {
  const target = href.replace(/\/$/, "") || "/";
  return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
};

// This page in each locale.
const languages = LOCALES.map((code) => ({ code, name: localeName(code), href: localePath(withoutLocale(Astro.url.pathname, locale), code) }));
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-canvas/85 backdrop-blur-md">
  <div class="container-page flex h-18 items-center gap-6">
    <a href={localePath("/", locale)} class="flex shrink-0 items-center gap-2.5" aria-label={settings.companyName}>
      {
        settings.logo ? (
          <Image src={settings.logo} alt={settings.companyName} class="h-8 w-auto" widths={[96, 192]} sizes="96px" />
        ) : (
          <>
            {/* Without a logo, a mark in the theme colours stands in for one. */}
            <span class="grid size-8 place-items-center bg-primary text-sm font-bold text-white" style="border-radius: var(--radius-theme)" aria-hidden="true">
              {settings.companyName.charAt(0)}
            </span>
            <span class="text-[15px] font-semibold tracking-tight">{settings.companyName}</span>
          </>
        )
      }
    </a>

    <!-- The menu is a details/summary disclosure: it opens and closes with no
         JavaScript at all, and is keyboard-operable by default. -->
    <details class="group ml-auto md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center rounded p-2 [&::-webkit-details-marker]:hidden"
        aria-label={labels.menu}
      >
        <svg viewBox="0 0 20 20" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round" class="group-open:hidden" />
          <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" class="hidden group-open:block" />
        </svg>
      </summary>

      <nav
        class="absolute inset-x-0 top-18 border-b border-line bg-canvas p-5 shadow-lg"
        aria-label={labels.mainMenu}
      >
        <ul class="space-y-1">
          {
            navigation.main.map((item) => (
              <li>
                <a
                  href={localePath(item.href, locale)}
                  class="block py-2 text-base font-medium aria-[current=page]:text-primary"
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
                {item.children.length > 0 && (
                  <ul class="ml-4 space-y-1 border-l border-line pl-3">
                    {item.children.map((child) => (
                      <li>
                        <a href={localePath(child.href, locale)} class="block py-1.5 text-sm text-muted">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <nav class="ml-auto hidden md:block" aria-label={labels.mainMenu}>
      <ul class="flex items-center gap-1">
        {
          navigation.main.map((item) => (
            <li class="group relative">
              <a
                href={localePath(item.href, locale)}
                class="relative block rounded-full px-3.5 py-2 text-sm font-medium text-ink/75 transition hover:bg-sunken hover:text-ink aria-[current=page]:bg-primary/8 aria-[current=page]:text-primary"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>

              {item.children.length > 0 && (
                <ul class="invisible absolute left-0 top-full min-w-48 rounded-lg border border-line bg-canvas py-1.5 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={localePath(child.href, locale)}
                        class="block px-4 py-1.5 text-sm text-muted transition hover:bg-sunken hover:text-ink"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={labels.languages}>
      <ul class="flex items-center gap-0.5 text-xs font-semibold uppercase tracking-wider">
        {
          languages.map((language) => (
            <li>
              <a
                href={language.href}
                hreflang={language.code}
                lang={language.code}
                title={language.name}
                aria-label={language.name}
                aria-current={language.code === locale ? "true" : undefined}
                class="block rounded-full px-2 py-1.5 text-muted transition hover:bg-sunken hover:text-ink aria-[current=true]:text-primary"
              >
                {language.code}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
