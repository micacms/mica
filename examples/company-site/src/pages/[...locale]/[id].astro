---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import EventList from "@/components/lists/EventList.astro";
import GlossaryList from "@/components/lists/GlossaryList.astro";
import NewsList from "@/components/lists/NewsList.astro";
import ProjectList from "@/components/lists/ProjectList.astro";
import TeamList from "@/components/lists/TeamList.astro";
import PageIntro from "@/components/PageIntro.astro";
import RichText from "@/components/RichText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPages, listPageProblems, toPlainText, type Entry } from "@/lib/content";
import { inEachLocale } from "@/lib/i18n";

/**
 * The `pages` collection — About, Services, Contact and whatever else an
 * editor creates, at the URL they chose, in each locale. A page with a list
 * template, such as /news/, shows its collection below its content. A new page
 * needs no change of the model; a new kind of list needs a template and an option.
 */
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const problems = listPageProblems(pages);
  if (problems.length > 0) {
    const message = `The list pages in Pages need a change:\n  ${problems.join("\n  ")}`;
    // In dev the next save is likely the fix; a build must not publish a site without its lists.
    if (import.meta.env.DEV) console.warn(message);
    else throw new Error(message);
  }
  return inEachLocale(async (locale) =>
    (await getPages(locale)).map((page) => ({
      params: { id: page.id },
      props: { page },
    })),
  );
}

interface Props {
  page: Entry<"pages">;
}

const { page } = Astro.props;
const { title, eyebrow, intro, heroImage, body, sections, seo } = page.data;
const template = page.data.template ?? "standard";

const LISTS = { projects: ProjectList, news: NewsList, events: EventList, team: TeamList, glossary: GlossaryList };
// An option that has no list yet renders as a standard page.
const List = template in LISTS ? LISTS[template as keyof typeof LISTS] : null;

const SECTION_LAYOUTS: Record<string, string> = {
  "image-right": "lg:grid-cols-2",
  "image-left": "lg:grid-cols-2 [&>figure]:lg:order-first",
  full: "",
};
---

<BaseLayout
  title={seo?.metaTitle ?? title}
  description={seo?.metaDescription ?? intro ?? toPlainText(body)}
  image={seo?.ogImage ?? heroImage?.src}
  noindex={seo?.noindex ?? false}
>
  {
    List ? (
      <PageIntro eyebrow={eyebrow} title={title} lead={intro} />
    ) : (
      <div class="container-page pb-12 pt-16 sm:pt-24">
        <div class="max-w-3xl">
          {eyebrow && <p class="eyebrow text-accent">{eyebrow}</p>}
          <h1 class:list={["text-4xl font-semibold sm:text-5xl lg:text-6xl", eyebrow && "mt-3"]}>{title}</h1>
          {intro && <p class="mt-6 text-lg text-muted text-pretty sm:text-xl">{intro}</p>}
        </div>
      </div>
    )
  }

  {
    heroImage && (
      <div class="container-page mb-16">
        <div class="media-frame">
          <Image
            {...heroImage}
            class="aspect-16/9 w-full object-cover lg:aspect-2/1"
            widths={[800, 1200, 1800]}
            sizes="(min-width: 1152px) 1120px, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }

  {
    body && (
      <div class="container-prose pb-4">
        <RichText text={body} from={page.data} />
      </div>
    )
  }

  {List && <List />}

  {
    sections.length > 0 && (
      <div class="container-page mt-20 space-y-20 sm:mt-28 sm:space-y-28">
        {sections.map((section) => (
          <section
            class:list={[
              "grid items-center gap-10 lg:gap-16",
              SECTION_LAYOUTS[section.layout ?? "image-right"],
            ]}
          >
            <div>
              <h2 class="text-3xl font-semibold sm:text-4xl">{section.heading}</h2>
              <div class="mt-5">
                <RichText text={section.text} from={page.data} />
              </div>
            </div>

            {section.image && (
              <figure class="media-frame shadow-xl shadow-ink/10">
                <Image
                  {...section.image}
                  class="aspect-4/3 w-full object-cover"
                  widths={[600, 1000]}
                  sizes="(min-width: 1024px) 45vw, 92vw"
                />
              </figure>
            )}
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
