---
import { Image } from "astro:assets";
import { related } from "@micacms/astro/relations";

import RichText from "@/components/RichText.astro";
import TagList from "@/components/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getLabels, getNews, inLocale, projectPath, toPlainText, type Entry } from "@/lib/content";
import { inEachLocale, localePath } from "@/lib/i18n";

export async function getStaticPaths() {
  return inEachLocale(async (locale) =>
    (await getNews(locale)).map((article) => ({
      params: { id: article.id },
      props: { article },
    })),
  );
}

interface Props {
  article: Entry<"news">;
}

const { article } = Astro.props;
const { title, publishDate, excerpt, coverImage, body, author, relatedProject, tags } = article.data;
const locale = Astro.currentLocale;

const writer = await related("team", author);
const found = await related("projects", relatedProject);
const project = found && inLocale(found, locale);
const { news: texts } = await getLabels(locale);
---

<BaseLayout
  title={title}
  description={excerpt ?? toPlainText(body)}
  image={coverImage?.src}
>
  <article>
    <div class="container-prose pb-10 pt-16 sm:pt-24">
      <a href={localePath("/news/", locale)} class="group inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-primary"><span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">←</span> {texts.allLink}</a>

      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">{title}</h1>

      <p class="mt-5 text-sm text-muted">
        {publishDate && <time datetime={publishDate}>{formatDate(publishDate, locale)}</time>}
        {
          writer && (
            <span>
              {publishDate ? " · " : ""}{texts.by}{" "}
              <a href={localePath(`/team/${writer.id}/`, locale)} class="font-medium text-ink hover:text-primary">{writer.data.name}</a>
            </span>
          )
        }
      </p>
      <div class="mt-3"><TagList tags={tags} /></div>

      {excerpt && <p class="mt-6 text-xl leading-relaxed text-muted text-pretty">{excerpt}</p>}
    </div>

    {
      coverImage && (
        <div class="container-page mb-14">
          <div class="media-frame">
            <Image
              {...coverImage}
              class="aspect-16/9 w-full object-cover lg:aspect-2/1"
              widths={[800, 1200, 1800]}
              sizes="(min-width: 1152px) 1120px, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    <div class="container-prose pb-8">
      <RichText text={body} from={article.data} />

      {
        project && (
          <a href={projectPath(project, locale)} class="card-surface group mt-12 flex items-center justify-between gap-4 p-5 transition hover:border-primary/40">
            <span>
              <span class="eyebrow block text-muted">{texts.relatedProject}</span>
              <span class="mt-1 block font-semibold group-hover:text-primary">{project.data.title}</span>
            </span>
            <span aria-hidden="true" class="text-primary transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        )
      }
    </div>
  </article>
</BaseLayout>
