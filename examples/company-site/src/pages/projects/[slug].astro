---
import { Image } from "astro:assets";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

import LocationMap from "@/components/LocationMap.astro";
import RichText from "@/components/RichText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toPlainText } from "@/lib/content";

/**
 * One page per published project. `entry.id` is the CMS slug, so the URL the
 * editor sees in the admin is exactly the URL that gets built.
 */
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, year, category, description, location, facts, gallery, team } = project.data;

const CATEGORY_LABELS: Record<string, string> = {
  residential: "Residential",
  commercial: "Commercial",
  public: "Public",
  renovation: "Renovation",
};

// Relations are stored as slugs; resolve them for display. A member deleted in
// the CMS simply drops out rather than breaking the build.
const members = (
  await Promise.all(team.map((slug) => getEntry("team", slug)))
).filter((member): member is CollectionEntry<"team"> => member !== undefined);

const cover = gallery[0] ?? null;
const rest = gallery.slice(1);

const addressLines = [location?.address, [location?.postalCode, location?.city].filter(Boolean).join(" ")]
  .filter(Boolean)
  .join("\n");
---

<BaseLayout
  title={title}
  description={toPlainText(description)}
  image={cover?.src}
>
  <article>
    <div class="container-page pb-10 pt-14 sm:pt-20">
      <a href="/projects/" class="text-sm text-muted hover:text-primary">← All projects</a>

      <div class="mt-4 max-w-3xl">
        <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h1>
        <p class="mt-3 text-muted">
          {[category ? CATEGORY_LABELS[category] : null, location?.city, year]
            .filter(Boolean)
            .join(" · ")}
        </p>
      </div>
    </div>

    {
      cover && (
        <div class="container-page">
          <div class="overflow-hidden bg-sunken" style="border-radius: var(--radius-theme)">
            <Image
              {...cover}
              class="w-full object-cover"
              widths={[800, 1200, 1800]}
              sizes="(min-width: 1152px) 1120px, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    <div class="container-page mt-12 grid gap-12 lg:grid-cols-[1fr_18rem]">
      <div>
        <RichText text={description} />
      </div>

      <aside class="space-y-8">
        {
          facts.length > 0 && (
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">Key facts</h2>
              <dl class="mt-3 divide-y divide-line border-t border-line text-sm">
                {facts.map((fact) => (
                  <div class="flex justify-between gap-4 py-2.5">
                    <dt class="text-muted">{fact.label}</dt>
                    <dd class="text-right font-medium">{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }

        {
          addressLines && (
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">Location</h2>
              <address class="mt-3 whitespace-pre-line text-sm not-italic">{addressLines}</address>
            </div>
          )
        }

        {
          members.length > 0 && (
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-muted">Team</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {members.map((member) => (
                  <li>
                    <span class="font-medium">{member.data.name}</span>
                    {member.data.role && <span class="block text-muted">{member.data.role}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      rest.length > 0 && (
        <div class="container-page mt-14">
          <h2 class="sr-only">Gallery</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {rest.map((image) => (
              <div class="overflow-hidden bg-sunken" style="border-radius: var(--radius-theme)">
                <Image
                  {...image}
                  class="w-full object-cover"
                  widths={[600, 1000]}
                  sizes="(min-width: 640px) 45vw, 92vw"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      location?.position && (
        <div class="container-page mt-14">
          <LocationMap
            position={location.position}
            label={title}
            address={addressLines}
            zoom={15}
          />
        </div>
      )
    }
  </article>
</BaseLayout>
