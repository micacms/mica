---
import { Image } from "astro:assets";
import { related } from "@micacms/astro/relations";
import { getCollection, type CollectionEntry } from "astro:content";

import RichText from "@/components/RichText.astro";
import TagList from "@/components/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, toPlainText } from "@/lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("news");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"news">;
}

const { article } = Astro.props;
const { title, publishDate, excerpt, coverImage, body, author, relatedProject, tags } = article.data;

const writer = await related("team", author);
const project = await related("projects", relatedProject);
---

<BaseLayout
  title={title}
  description={excerpt ?? toPlainText(body)}
  image={coverImage?.src}
>
  <article>
    <div class="container-prose pb-8 pt-14 sm:pt-20">
      <a href="/news/" class="text-sm text-muted hover:text-primary">← All news</a>

      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>

      <p class="mt-3 text-sm text-muted">
        {publishDate && <time datetime={publishDate}>{formatDate(publishDate)}</time>}
        {
          writer && (
            <span>
              {publishDate ? " · " : ""}by{" "}
              <a href={`/team/${writer.id}/`} class="hover:text-primary">{writer.data.name}</a>
            </span>
          )
        }
      </p>
      <div class="mt-3"><TagList tags={tags} /></div>

      {excerpt && <p class="mt-5 text-lg text-muted text-pretty">{excerpt}</p>}
    </div>

    {
      coverImage && (
        <div class="container-page mb-10">
          <div class="overflow-hidden bg-sunken" style="border-radius: var(--radius-theme)">
            <Image
              {...coverImage}
              class="w-full object-cover"
              widths={[800, 1200, 1800]}
              sizes="(min-width: 1152px) 1120px, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    <div class="container-prose pb-8">
      <RichText text={body} />

      {
        project && (
          <p class="mt-8 border-t border-line pt-4 text-sm">
            Related project:{" "}
            <a href={`/projects/${project.id}/`} class="font-medium text-primary hover:underline">
              {project.data.title}
            </a>
          </p>
        )
      }
    </div>
  </article>
</BaseLayout>
