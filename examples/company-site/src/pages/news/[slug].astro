---
import { Image } from "astro:assets";
import { related } from "@micacms/astro/relations";
import { getCollection, type CollectionEntry } from "astro:content";

import RichText from "@/components/RichText.astro";
import TagList from "@/components/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, toPlainText } from "@/lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("news");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"news">;
}

const { article } = Astro.props;
const { title, publishDate, excerpt, coverImage, body, author, relatedProject, tags } = article.data;

const writer = await related("team", author);
const project = await related("projects", relatedProject);
---

<BaseLayout
  title={title}
  description={excerpt ?? toPlainText(body)}
  image={coverImage?.src}
>
  <article>
    <div class="container-prose pb-10 pt-16 sm:pt-24">
      <a href="/news/" class="group inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-primary"><span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">←</span> All news</a>

      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">{title}</h1>

      <p class="mt-5 text-sm text-muted">
        {publishDate && <time datetime={publishDate}>{formatDate(publishDate)}</time>}
        {
          writer && (
            <span>
              {publishDate ? " · " : ""}by{" "}
              <a href={`/team/${writer.id}/`} class="font-medium text-ink hover:text-primary">{writer.data.name}</a>
            </span>
          )
        }
      </p>
      <div class="mt-3"><TagList tags={tags} /></div>

      {excerpt && <p class="mt-6 text-xl leading-relaxed text-muted text-pretty">{excerpt}</p>}
    </div>

    {
      coverImage && (
        <div class="container-page mb-14">
          <div class="media-frame">
            <Image
              {...coverImage}
              class="aspect-16/9 w-full object-cover lg:aspect-2/1"
              widths={[800, 1200, 1800]}
              sizes="(min-width: 1152px) 1120px, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    <div class="container-prose pb-8">
      <RichText text={body} />

      {
        project && (
          <a href={`/projects/${project.id}/`} class="card-surface group mt-12 flex items-center justify-between gap-4 p-5 transition hover:border-primary/40">
            <span>
              <span class="eyebrow block text-muted">Related project</span>
              <span class="mt-1 block font-semibold group-hover:text-primary">{project.data.title}</span>
            </span>
            <span aria-hidden="true" class="text-primary transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        )
      }
    </div>
  </article>
</BaseLayout>
