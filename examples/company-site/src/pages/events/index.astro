---
import PageIntro from "@/components/PageIntro.astro";
import TagList from "@/components/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FORMAT_LABELS, formatDateTime, getEvents } from "@/lib/content";

// Upcoming events first, then the past ones. Both lists come from one helper.
const { upcoming, past } = await getEvents();
const groups = [
  { heading: "Upcoming", items: upcoming, empty: "No events are planned right now." },
  { heading: "Past", items: past, empty: "" },
];
---

<BaseLayout title="Events" description="Workshops and talks, in person and online.">
  <PageIntro eyebrow="Meet us" title="Events" lead="Workshops and talks, in person and online." />

  <div class="container-page space-y-12 pb-8">
    {
      groups.map(({ heading, items, empty }) => (
        <section>
          <h2 class="border-b border-line pb-3 text-xl font-semibold tracking-tight">{heading}</h2>
          {items.length === 0 ? (
            empty && <p class="mt-4 text-muted">{empty}</p>
          ) : (
            <ul class="divide-y divide-line">
              {items.map((event) => (
                <li class="py-6">
                  <a href={`/events/${event.id}/`} class="group block">
                    <time datetime={event.data.startsAt} class="text-xs text-muted">
                      {formatDateTime(event.data.startsAt)}
                    </time>
                    <h3 class="mt-1 text-xl font-semibold tracking-tight group-hover:text-primary">
                      {event.data.title}
                    </h3>
                    <p class="mt-1 text-sm text-muted">
                      {event.data.format.map((value) => FORMAT_LABELS[value] ?? value).join(" · ")}
                      {event.data.venue?.name ? ` · ${event.data.venue.name}` : ""}
                    </p>
                    {event.data.summary && (
                      <p class="mt-2 text-muted text-pretty">{event.data.summary}</p>
                    )}
                  </a>
                  <div class="mt-3">
                    <TagList tags={event.data.tags} />
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
