---
import { Image } from "astro:assets";
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  formatDate,
  formatDateTime,
  getEvents,
  getNews,
  getProjects,
  getSiteSettings,
} from "@/lib/content";

const settings = await getSiteSettings();

const featured = await getProjects({ featuredOnly: true });
const allProjects = await getProjects();
// An empty "featured" list should not produce an empty homepage.
const showcase = (featured.length > 0 ? featured : allProjects).slice(0, 3);

const news = (await getNews()).slice(0, 3);
const upcomingEvents = (await getEvents()).upcoming.slice(0, 3);
---

<BaseLayout>
  <section class="container-page pb-16 pt-20 sm:pb-24 sm:pt-28">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        {settings.tagline ?? settings.companyName}
      </h1>
      {
        settings.seo?.defaultDescription && (
          <p class="mt-6 max-w-2xl text-lg text-muted text-pretty sm:text-xl">
            {settings.seo.defaultDescription}
          </p>
        )
      }

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/projects/" class="btn-solid">See our work</a>
        <a href="/contact/" class="btn-outline">Get in touch</a>
      </div>
    </div>
  </section>

  {
    showcase.length > 0 && (
      <section class="container-page" aria-labelledby="projects-heading">
        <div class="flex items-end justify-between gap-4 border-t border-line pt-10">
          <h2 id="projects-heading" class="text-2xl font-semibold tracking-tight">
            Selected projects
          </h2>
          <a href="/projects/" class="shrink-0 text-sm font-medium text-primary hover:underline">
            All projects →
          </a>
        </div>

        <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {showcase.map((project, index) => (
            <ProjectCard project={project} priority={index === 0} />
          ))}
        </div>
      </section>
    )
  }

  {
    upcomingEvents.length > 0 && (
      <section class="container-page mt-20" aria-labelledby="events-heading">
        <div class="flex items-end justify-between gap-4 border-t border-line pt-10">
          <h2 id="events-heading" class="text-2xl font-semibold tracking-tight">
            Upcoming events
          </h2>
          <a href="/events/" class="shrink-0 text-sm font-medium text-primary hover:underline">
            All events →
          </a>
        </div>

        <ul class="mt-8 grid gap-8 sm:grid-cols-3">
          {upcomingEvents.map((event) => (
            <li>
              <a href={`/events/${event.id}/`} class="group block">
                <time datetime={event.data.startsAt} class="text-xs text-muted">
                  {formatDateTime(event.data.startsAt)}
                </time>
                <h3 class="mt-1 font-semibold tracking-tight group-hover:text-primary">
                  {event.data.title}
                </h3>
                {event.data.summary && (
                  <p class="mt-1.5 text-sm text-muted">{event.data.summary}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    news.length > 0 && (
      <section class="container-page mt-20" aria-labelledby="news-heading">
        <div class="flex items-end justify-between gap-4 border-t border-line pt-10">
          <h2 id="news-heading" class="text-2xl font-semibold tracking-tight">
            Latest news
          </h2>
          <a href="/news/" class="shrink-0 text-sm font-medium text-primary hover:underline">
            All news →
          </a>
        </div>

        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          {news.map((article) => (
            <article>
              <a href={`/news/${article.id}/`} class="group block">
                {article.data.coverImage && (
                  <div
                    class="mb-4 aspect-16/9 overflow-hidden bg-sunken"
                    style="border-radius: var(--radius-theme)"
                  >
                    <Image
                      src={article.data.coverImage.src}
                      alt={article.data.coverImage.alt}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                      widths={[400, 800]}
                      sizes="(min-width: 640px) 30vw, 90vw"
                    />
                  </div>
                )}

                {article.data.publishDate && (
                  <time datetime={article.data.publishDate} class="text-xs text-muted">
                    {formatDate(article.data.publishDate)}
                  </time>
                )}
                <h3 class="mt-1 font-semibold tracking-tight group-hover:text-primary">
                  {article.data.title}
                </h3>
                {article.data.excerpt && (
                  <p class="mt-1.5 text-sm text-muted">{article.data.excerpt}</p>
                )}
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
