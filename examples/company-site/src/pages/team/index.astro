---
import { Image } from "astro:assets";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedTeam } from "@/lib/content";

const team = await getFeaturedTeam();
---

<BaseLayout title="Team" description="The people behind the work.">
  <PageIntro eyebrow="People" title="Team" lead="The people behind the work." />

  <div class="container-page pb-8">
    {
      team.length === 0 ? (
        <p class="text-muted">No team members have been published yet.</p>
      ) : (
        <ul class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((member, index) => (
            <li class="group relative">
              {member.data.portrait ? (
                <div class="media-frame aspect-4/5">
                  <Image
                    {...member.data.portrait}
                    class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03]"
                    widths={[320, 640]}
                    sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                    loading={index < 3 ? "eager" : "lazy"}
                    fetchpriority={index < 3 ? "high" : "auto"}
                  />
                </div>
              ) : (
                <div
                  class="media-frame flex aspect-4/5 items-center justify-center bg-primary/8 text-4xl font-semibold text-primary"
                  aria-hidden="true"
                >
                  {member.data.name
                    .split(" ")
                    .slice(0, 2)
                    .map((part) => part[0])
                    .join("")}
                </div>
              )}

              <h2 class="mt-5 text-lg font-semibold">
                {/* The link covers the whole card; the contact links below sit above it. */}
                <a href={`/team/${member.id}/`} class="transition group-hover:text-primary after:absolute after:inset-0">{member.data.name}</a>
              </h2>
              {member.data.role && (
                <p class="eyebrow mt-1 text-accent">{member.data.role}</p>
              )}
              {member.data.bio && (
                <p class="mt-3 line-clamp-3 text-sm text-muted text-pretty">
                  {member.data.bio}
                </p>
              )}

              <div class="relative mt-4 space-y-0.5 text-sm">
                {member.data.email && (
                  <p>
                    <a
                      href={`mailto:${member.data.email}`}
                      class="text-primary hover:underline"
                    >
                      {member.data.email}
                    </a>
                  </p>
                )}
                {member.data.phone && (
                  <p>
                    <a
                      href={`tel:${member.data.phone.replace(/\s/g, "")}`}
                      class="text-muted hover:text-primary"
                    >
                      {member.data.phone}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
