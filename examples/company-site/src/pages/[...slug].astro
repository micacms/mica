---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

import RichText from "@/components/RichText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toPlainText } from "@/lib/content";

/**
 * Catch-all for the `pages` collection — About, Services, Contact and whatever
 * else an editor creates, at the URL they chose.
 *
 * More specific routes (`/projects`, `/news`, `/team`) win, so a page whose
 * slug collides with one of those is simply shadowed.
 */
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<"pages">;
}

const { page } = Astro.props;
const { title, intro, heroImage, body, sections, seo } = page.data;

const SECTION_LAYOUTS: Record<string, string> = {
  "image-right": "lg:grid-cols-2",
  "image-left": "lg:grid-cols-2 [&>figure]:lg:order-first",
  full: "",
};
---

<BaseLayout
  title={seo?.metaTitle ?? title}
  description={seo?.metaDescription ?? intro ?? toPlainText(body)}
  image={seo?.ogImage ?? heroImage?.src}
  noindex={seo?.noindex ?? false}
>
  <div class="container-page pb-12 pt-16 sm:pt-24">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-semibold sm:text-5xl lg:text-6xl">{title}</h1>
      {intro && <p class="mt-6 text-lg text-muted text-pretty sm:text-xl">{intro}</p>}
    </div>
  </div>

  {
    heroImage && (
      <div class="container-page mb-16">
        <div class="media-frame">
          <Image
            {...heroImage}
            class="aspect-16/9 w-full object-cover lg:aspect-2/1"
            widths={[800, 1200, 1800]}
            sizes="(min-width: 1152px) 1120px, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }

  {
    body && (
      <div class="container-prose pb-4">
        <RichText text={body} images={page.data._mica.images} />
      </div>
    )
  }

  {
    sections.length > 0 && (
      <div class="container-page mt-20 space-y-20 sm:mt-28 sm:space-y-28">
        {sections.map((section) => (
          <section
            class:list={[
              "grid items-center gap-10 lg:gap-16",
              SECTION_LAYOUTS[section.layout ?? "image-right"],
            ]}
          >
            <div>
              <h2 class="text-3xl font-semibold sm:text-4xl">{section.heading}</h2>
              <div class="mt-5">
                <RichText text={section.text} images={page.data._mica.images} />
              </div>
            </div>

            {section.image && (
              <figure class="media-frame shadow-xl shadow-ink/10">
                <Image
                  {...section.image}
                  class="aspect-4/3 w-full object-cover"
                  widths={[600, 1000]}
                  sizes="(min-width: 1024px) 45vw, 92vw"
                />
              </figure>
            )}
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
