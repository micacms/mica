{
  "protocolVersion": 1,
  "generatedBy": "@micacms/astro",
  "collections": {
    "pages": {
      "type": "collection",
      "name": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "description": "Standalone pages such as About us, Services or Contact.",
      "defaultSort": {
        "field": "position",
        "direction": "asc"
      },
      "sortable": true,
      "fields": {
        "title": {
          "kind": "text",
          "label": "Title",
          "required": true,
          "maxLength": 120,
          "listed": true
        },
        "slug": {
          "kind": "slug",
          "label": "URL",
          "from": "title",
          "description": "The address of the page, e.g. /about-us."
        },
        "intro": {
          "kind": "textarea",
          "label": "Introduction",
          "rows": 3,
          "maxLength": 400,
          "description": "Short lead paragraph shown below the page title."
        },
        "heroImage": {
          "kind": "media",
          "label": "Hero image",
          "accept": "image",
          "alt": "required"
        },
        "body": {
          "kind": "richText",
          "label": "Content",
          "toolbar": "full"
        },
        "sections": {
          "kind": "repeater",
          "label": "Extra sections",
          "itemLabel": "heading",
          "addLabel": "Add section",
          "fields": {
            "heading": {
              "kind": "text",
              "label": "Heading",
              "required": true
            },
            "text": {
              "kind": "richText",
              "label": "Text"
            },
            "image": {
              "kind": "media",
              "label": "Image",
              "accept": "image",
              "alt": "required"
            },
            "layout": {
              "kind": "select",
              "label": "Layout",
              "options": [
                {
                  "label": "Image right",
                  "value": "image-right"
                },
                {
                  "label": "Image left",
                  "value": "image-left"
                },
                {
                  "label": "Full width",
                  "value": "full"
                }
              ],
              "default": "image-right"
            }
          }
        },
        "seo": {
          "kind": "object",
          "label": "SEO",
          "group": "Metadata",
          "collapsible": true,
          "collapsed": true,
          "fields": {
            "metaTitle": {
              "kind": "text",
              "label": "Meta title",
              "maxLength": 60
            },
            "metaDescription": {
              "kind": "textarea",
              "label": "Meta description",
              "rows": 2,
              "maxLength": 160
            },
            "ogImage": {
              "kind": "media",
              "label": "Social sharing image",
              "accept": "image"
            },
            "noindex": {
              "kind": "boolean",
              "label": "Hide from search engines"
            }
          }
        }
      }
    },
    "projects": {
      "type": "collection",
      "name": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Client projects shown in the portfolio.",
