            "heading": {
              "kind": "text",
              "label": "Heading",
              "required": true
            },
            "text": {
              "kind": "richText",
              "label": "Text"
            },
            "image": {
              "kind": "media",
              "label": "Image",
              "accept": "image",
              "alt": "required"
            },
            "layout": {
              "kind": "select",
              "label": "Layout",
              "options": [
                {
                  "label": "Image right",
                  "value": "image-right"
                },
                {
                  "label": "Image left",
                  "value": "image-left"
                },
                {
                  "label": "Full width",
                  "value": "full"
                }
              ],
              "default": "image-right"
            }
          }
        },
        "seo": {
          "kind": "object",
          "label": "SEO",
          "group": "Metadata",
          "collapsible": true,
          "collapsed": true,
          "fields": {
            "metaTitle": {
              "kind": "text",
              "label": "Meta title",
              "maxLength": 60
            },
            "metaDescription": {
              "kind": "textarea",
              "label": "Meta description",
              "rows": 2,
              "maxLength": 160
            },
            "ogImage": {
              "kind": "media",
              "label": "Social sharing image",
              "accept": "image"
            },
            "noindex": {
              "kind": "boolean",
              "label": "Hide from search engines"
            }
          }
        }
      }
    },
    "projects": {
      "type": "collection",
