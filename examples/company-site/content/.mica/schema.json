  "collections": {
    "pages": {
      "type": "collection",
      "name": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "description": "Standalone pages such as About us, Services or Contact.",
      "url": "/{slug}/",
      "defaultSort": {
        "field": "position",
        "direction": "asc"
      },
      "sortable": true,
      "fields": {
        "title": {
          "kind": "text",
          "label": "Title",
          "required": true,
          "maxLength": 120,
          "listed": true
