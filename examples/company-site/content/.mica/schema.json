        "slug": {
          "kind": "slug",
          "label": "URL",
          "from": "title",
          "description": "The address of the page, e.g. /about-us."
        },
        "template": {
          "kind": "select",
          "label": "Template",
          "description": "A list page shows its collection below the content. Its URL must be the collection's: news for News, projects for Projects.",
          "width": "half",
          "default": "standard",
          "options": [
            {
              "label": "Standard page",
              "value": "standard"
            },
            {
              "label": "List of projects",
              "value": "projects"
            },
            {
              "label": "List of news",
              "value": "news"
            },
            {
              "label": "List of events",
              "value": "events"
            },
            {
              "label": "List of the team",
              "value": "team"
            },
            {
              "label": "Glossary",
              "value": "glossary"
            }
          ]
        },
        "eyebrow": {
          "kind": "text",
          "label": "Eyebrow",
          "maxLength": 40,
          "width": "half",
          "description": "The short line above the title."
        },
        "intro": {
          "kind": "textarea",
          "label": "Introduction",
          "rows": 3,
          "maxLength": 400,
          "description": "Short lead paragraph shown below the page title."
        },
        "heroImage": {
          "kind": "media",
          "label": "Hero image",
          "accept": "image",
          "alt": "required"
        },
        "body": {
          "kind": "richText",
          "label": "Content",
          "toolbar": "full"
        },
        "sections": {
          "kind": "repeater",
          "label": "Extra sections",
          "itemLabel": "heading",
          "addLabel": "Add section",
