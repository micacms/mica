          "width": "half",
          "pattern": "[A-Z]{2}-[0-9]{3}",
          "patternMessage": "Use two capital letters, a hyphen and three digits, like HL-104."
        },
        "duration": {
          "kind": "number",
          "label": "Duration",
          "integer": true,
          "min": 1,
          "unit": "weeks",
          "width": "half"
        },
        "tags": {
          "kind": "tags",
          "label": "Tags",
          "max": 6,
          "maxLength": 24,
          "suggestions": [
            "process",
            "finance",
            "data",
            "software",
            "people",
            "strategy"
          ]
        },
        "description": {
          "kind": "richText",
          "label": "Description",
          "toolbar": [
            "bold",
            "italic",
            "heading",
            "bulletList",
            "orderedList",
            "link",
            "image"
          ]
        },
        "location": {
          "kind": "object",
          "label": "Location",
          "fields": {
            "address": {
              "kind": "text",
              "label": "Address"
            },
            "city": {
              "kind": "text",
              "label": "City",
              "width": "half"
            },
            "country": {
              "kind": "text",
              "label": "Country",
              "width": "half"
            }
          }
        },
        "facts": {
          "kind": "repeater",
          "label": "Key facts",
          "itemLabel": "label",
          "addLabel": "Add fact",
          "max": 8,
          "fields": {
            "label": {
              "kind": "text",
              "label": "Label",
              "required": true,
              "width": "half"
            },
            "value": {
              "kind": "text",
              "label": "Value",
              "required": true,
              "width": "half"
            }
          }
        },
        "gallery": {
          "kind": "media",
          "label": "Images",
          "accept": "image",
          "alt": "required",
          "multiple": true,
          "description": "The first image is used as the preview."
        },
        "team": {
          "kind": "relation",
          "label": "Team involved",
          "collection": "team",
          "multiple": true
        },
        "sector": {
          "kind": "relation",
          "label": "Sector",
          "collection": "sectors",
          "description": "The client's economic sector, from the NACE list."
        },
        "downloads": {
          "kind": "media",
          "label": "Downloads",
          "accept": [
            "pdf",
            "zip",
            "csv"
          ],
          "multiple": true,
          "max": 4,
          "description": "Files that visitors can download, such as a case study."
        },
        "featured": {
          "kind": "boolean",
          "label": "Show on the homepage"
        }
      }
    },
