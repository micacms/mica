        "category": {
          "kind": "select",
          "label": "Category",
          "width": "half",
          "listed": true,
          "options": [
            {
              "label": "Strategy",
              "value": "strategy"
            },
            {
              "label": "Operations",
              "value": "operations"
            },
            {
              "label": "Technology",
              "value": "technology"
            },
            {
              "label": "Public sector",
              "value": "public-sector"
            }
          ]
        },
        "code": {
          "kind": "text",
          "label": "Project number",
          "readonly": true,
          "width": "half",
          "pattern": "[A-Z]{2}-[0-9]{3}",
          "patternMessage": "Use two capital letters, a hyphen and three digits, like HL-104."
        },
        "duration": {
          "kind": "number",
          "label": "Duration",
          "integer": true,
          "min": 1,
          "unit": "weeks",
          "width": "half"
        },
        "tags": {
          "kind": "tags",
          "label": "Tags",
          "max": 6,
          "maxLength": 24,
          "suggestions": [
            "process",
            "finance",
            "data",
            "software",
            "people",
            "strategy"
          ]
        },
        "description": {
          "kind": "richText",
          "label": "Description",
          "toolbar": [
            "bold",
            "italic",
            "heading",
            "bulletList",
            "orderedList",
            "link",
            "image"
          ]
        },
        "location": {
          "kind": "object",
          "label": "Location",
          "fields": {
            "address": {
              "kind": "text",
              "label": "Address"
            },
            "city": {
              "kind": "text",
              "label": "City",
              "width": "half"
            },
            "country": {
              "kind": "text",
              "label": "Country",
              "width": "half"
            }
          }
        },
        "facts": {
          "kind": "repeater",
          "label": "Key facts",
          "itemLabel": "label",
          "addLabel": "Add fact",
          "max": 8,
          "fields": {
            "label": {
              "kind": "text",
              "label": "Label",
              "required": true,
              "width": "half"
            },
            "value": {
              "kind": "text",
              "label": "Value",
              "required": true,
              "width": "half"
            }
          }
        },
        "gallery": {
          "kind": "media",
          "label": "Images",
          "accept": "image",
          "alt": "required",
          "multiple": true,
          "description": "The first image is used as the preview."
        },
        "team": {
          "kind": "relation",
          "label": "Team involved",
          "collection": "team",
          "multiple": true
        },
        "featured": {
          "kind": "boolean",
          "label": "Show on the homepage"
        }
      }
    },
    "news": {
