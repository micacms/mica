---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import RichText from "@/components/RichText.astro";
import { getFeatures } from "@/lib/content";
export async function getStaticPaths() { return (await getCollection("features")).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const features = await getFeatures();
const currentIndex = features.findIndex((feature) => feature.id === entry.id);
const next = features[(currentIndex + 1) % features.length];
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <section class="bg-ink bg-[linear-gradient(rgba(255,255,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.025)_1px,transparent_1px)] bg-[size:48px_48px] py-20 text-white md:py-28"><div class="mx-auto grid w-full max-w-[1180px] items-center gap-12 px-5 sm:px-8 md:grid-cols-[1fr_auto]"><div><a class="mb-12 inline-flex text-xs text-white/45 hover:text-white" href="/#features">← All features</a><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-accent before:h-px before:w-6 before:bg-current">{entry.data.eyebrow}</p><h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-[-.05em] md:text-7xl">{entry.data.title}</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/60">{entry.data.summary}</p></div><div class="hidden h-44 w-44 rotate-3 items-center justify-center rounded-3xl border border-white/10 bg-white/5 text-accent md:flex"><Icon name={entry.data.icon} size={64} strokeWidth={1.2} /></div></div></section>
  <section class="bg-paper py-24 md:py-32"><div class="mx-auto grid w-full max-w-[1180px] gap-12 px-5 sm:px-8 lg:grid-cols-[280px_1fr] lg:gap-24"><aside class="self-start rounded-xl border border-line bg-cream p-6 lg:sticky lg:top-28"><span class="mb-5 block font-mono text-[10px] uppercase tracking-wider text-muted">What you get</span>{entry.data.outcomes.map((outcome) => <p class="flex items-start gap-2 border-t border-[#d7dacc] py-3 text-sm"><span class="mt-0.5 shrink-0 text-[#5e8412]"><Icon name="check" size={15} /></span>{outcome.text}</p>)}</aside><RichText text={entry.data.detail} /></div></section>
  {next && <a class="block border-t border-line bg-cream py-10 transition hover:bg-[#e9ebdf]" href={`/features/${next.id}/`}><div class="mx-auto grid w-full max-w-[1180px] grid-cols-[1fr_auto] items-center gap-2 px-5 sm:px-8 md:grid-cols-[160px_1fr_auto]"><span class="font-mono text-[10px] uppercase tracking-wider text-muted">Next capability</span><strong class="col-start-1 text-xl md:col-start-2">{next.data.title}</strong><span class="row-span-2"><Icon name="arrow" size={28} /></span></div></a>}
</BaseLayout>
