---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import EditorPreview from "@/components/EditorPreview.astro";
import Icon from "@/components/Icon.astro";
import { getFeatures, getHome, getSite } from "@/lib/content";
const [home, site, features] = await Promise.all([getHome(), getSite(), getFeatures()]);
---

<BaseLayout>
  <section class="overflow-hidden bg-ink bg-[linear-gradient(rgba(255,255,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.025)_1px,transparent_1px)] bg-[size:48px_48px] pb-0 pt-14 text-white md:pt-20">
    <div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8">
      <a class="mx-auto flex w-fit items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/70 transition hover:border-white/20 hover:text-white" href={site.announcement.href}><span class="rounded-full bg-accent px-2 py-0.5 font-semibold text-ink">New</span>{site.announcement.text}<Icon name="arrow" size={14} /></a>
      <div class="grid items-center gap-14 pb-20 pt-14 lg:grid-cols-[.92fr_1.08fr] lg:gap-20 lg:pb-24 lg:pt-20">
        <div>
          <p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-accent before:h-px before:w-6 before:bg-current">{home.heroEyebrow}</p>
          <h1 class="max-w-2xl text-5xl font-semibold leading-[.96] tracking-[-.055em] text-balance sm:text-6xl lg:text-[4.55rem]">{home.heroTitle}</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/60">{home.heroSummary}</p>
          <div class="mt-8 flex flex-wrap gap-3"><a class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent px-5 text-sm font-semibold text-ink transition hover:-translate-y-px hover:bg-[#e5ff91]" href={home.primaryCta.href}>{home.primaryCta.label}</a><a class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/5 px-5 text-sm font-semibold text-white transition hover:-translate-y-px hover:border-white/35 hover:bg-white/10" href={home.secondaryCta.href} target="_blank" rel="noreferrer"><Icon name="github" size={18} /> {home.secondaryCta.label}</a></div>
          <div class="mt-5 flex max-w-[510px] items-center justify-between gap-3 rounded-lg border border-white/10 bg-black/25 py-2 pl-4 pr-2"><code class="overflow-hidden text-ellipsis whitespace-nowrap font-mono text-[11px] text-white/55 sm:text-xs">npm install @micacms/astro @micacms/model</code><button class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md border-0 bg-white/5 text-white/55 transition hover:bg-white/10 hover:text-white [&.copied]:text-accent" data-copy="npm install @micacms/astro @micacms/model" aria-label="Copy install command"><Icon name="copy" size={16} /></button></div>
        </div>
        <div class="relative before:absolute before:inset-[13%_-12%_-10%_10%] before:-z-10 before:bg-[rgba(217,255,99,.12)] before:blur-[80px]"><CodeWindow /></div>
      </div>
      <div class="grid border-t border-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {home.stats.map((stat) => <div class="grid grid-cols-[auto_1fr] items-baseline gap-x-4 border-b border-white/10 py-6 sm:border-r sm:px-6 lg:border-b-0 first:pl-0"><strong class="row-span-2 text-3xl font-semibold tracking-tight text-accent">{stat.value}</strong><span class="text-sm text-white/80">{stat.label}</span><small class="text-xs text-white/35">{stat.note}</small></div>)}
      </div>
    </div>
  </section>

  <section class="bg-paper py-24 md:py-32">
    <div class="mx-auto grid w-full max-w-[1180px] gap-16 px-5 sm:px-8 lg:grid-cols-[.82fr_1.18fr] lg:gap-24">
      <div class="max-w-[700px] lg:sticky lg:top-32 lg:self-start"><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-[#51710c] before:h-px before:w-6 before:bg-current">{home.problemEyebrow}</p><h2 class="text-4xl font-semibold leading-[1.05] tracking-[-.045em] md:text-5xl">{home.problemTitle}</h2><p class="mt-6 text-lg leading-relaxed text-muted">{home.problemSummary}</p></div>
      <div class="rounded-2xl border border-line bg-white p-5 shadow-sm sm:p-8">
        <div class="flex items-center gap-4 rounded-xl border border-line bg-paper p-4"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cream"><Icon name="edit" /></span><div><small class="block font-mono text-[9px] font-semibold tracking-[.14em] text-muted">EDITOR</small><strong class="block text-sm font-semibold">Writes in Mica</strong></div></div>
        <div class="relative flex h-16 justify-center before:h-full before:w-px before:bg-line after:absolute after:bottom-0 after:h-[7px] after:w-[7px] after:rotate-45 after:border-b after:border-r after:border-[#9ba198]"><span class="absolute top-1/2 -translate-y-1/2 bg-white px-3 font-mono text-[9px] uppercase tracking-wider text-muted">one commit</span></div>
        <div class="flex items-center gap-4 rounded-xl border border-ink bg-ink p-4 text-white shadow-[0_14px_30px_rgba(13,18,16,.13)]"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent text-ink"><Icon name="repository" /></span><div><small class="block font-mono text-[9px] font-semibold tracking-[.14em] text-white/45">SOURCE OF TRUTH</small><strong class="block text-sm font-semibold">Your repository</strong><code class="mt-1 block font-mono text-[10px] text-white/45">content/…</code></div></div>
        <div class="mx-auto flex h-16 w-[52%] border-x border-t border-line"><span class="w-1/2"></span><span class="w-1/2"></span></div>
        <div class="grid gap-4 sm:grid-cols-2"><div class="rounded-xl border border-line bg-paper p-4"><small class="block font-mono text-[9px] font-semibold tracking-[.14em] text-muted">BUILD</small><strong class="block text-sm font-semibold">Astro</strong><code class="mt-1 block font-mono text-[10px] text-muted">getCollection()</code></div><div class="rounded-xl border border-line bg-paper p-4"><small class="block font-mono text-[9px] font-semibold tracking-[.14em] text-muted">DEPLOY</small><strong class="block text-sm font-semibold">Any static host</strong><code class="mt-1 block font-mono text-[10px] text-muted">HTML + CSS + assets</code></div></div>
        <div class="mt-6 flex items-center justify-center gap-2 rounded-lg bg-cream px-4 py-3 text-xs font-medium text-muted"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-white text-[#55780e]"><Icon name="check" size={15} /></span> The website never contacts Mica.</div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-ink py-24 text-white md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8"><div class="mx-auto max-w-[700px] text-center"><p class="mb-5 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-accent before:h-px before:w-6 before:bg-current">From model to production</p><h2 class="text-4xl font-semibold leading-[1.05] tracking-[-.045em] md:text-5xl">{home.workflowTitle}</h2><p class="mt-6 text-lg leading-relaxed text-white/60">{home.workflowSummary}</p></div><div class="mt-16 grid border-y border-white/10 md:grid-cols-3">{home.workflowSteps.map((step, index) => <article class="border-b border-white/10 py-8 md:border-b-0 md:border-r md:px-8 md:py-10 md:first:pl-0 md:last:border-0 md:last:pr-0"><div class="mb-12 flex items-center font-mono text-xs text-accent"><span>0{index + 1}</span>{index < home.workflowSteps.length - 1 && <i class="ml-auto text-white/25"><Icon name="arrow" size={18} /></i>}</div><h3 class="text-2xl font-semibold tracking-tight">{step.title}</h3><p class="mt-3 text-sm leading-relaxed text-white/55">{step.text}</p><code class="mt-8 inline-block rounded-md border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-[10px] text-white/50">{step.detail}</code></article>)}</div></div></section>

  <section class="bg-[#f6f7f2] py-24 md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8"><div class="mb-14 grid items-end gap-8 md:grid-cols-2"><div><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-[#51710c] before:h-px before:w-6 before:bg-current">For the people who write</p><h2 class="text-4xl font-semibold leading-[1.05] tracking-[-.045em] md:text-5xl">A real editor. Not a repository with nicer colours.</h2></div><p class="max-w-lg justify-self-end text-lg leading-relaxed text-muted">Model-generated forms give editors the controls they need. Validation happens before a complete entry reaches the repository.</p></div><EditorPreview /><div class="mt-8 grid gap-3 text-xs font-medium text-muted sm:grid-cols-2 lg:grid-cols-4">{["Focused field controls","Markdoc rich text","Media and relations","Conflict protection"].map((item) => <span class="flex items-center gap-2 text-[#628916]"><Icon name="check" size={15} /><i class="not-italic text-muted">{item}</i></span>)}</div></div></section>

  <section id="features" class="bg-cream py-24 md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8"><div class="mb-14 grid items-end gap-8 md:grid-cols-2"><div><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-[#51710c] before:h-px before:w-6 before:bg-current">{home.featuresEyebrow}</p><h2 class="text-4xl font-semibold leading-[1.05] tracking-[-.045em] md:text-5xl">{home.featuresTitle}</h2></div><p class="max-w-lg justify-self-end text-lg leading-relaxed text-muted">{home.featuresSummary}</p></div><div class="grid gap-px overflow-hidden rounded-xl border border-[#cfd4ca] bg-[#cfd4ca] md:grid-cols-2 lg:grid-cols-3">{features.map((feature, index) => <a class:list={["group flex min-h-[340px] flex-col bg-[#fafbf7] p-7 transition hover:bg-white md:p-8", index === 0 && "lg:col-span-2"]} href={`/features/${feature.id}/`}><div class="mb-8 flex items-start justify-between font-mono text-[10px] text-[#9ca49d]"><span class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#e8fcb2] text-[#344a08] transition group-hover:-rotate-4 group-hover:bg-accent"><Icon name={feature.data.icon} /></span><span>0{index + 1}</span></div><p class="mb-2 font-mono text-[10px] uppercase tracking-[.12em] text-[#73806f]">{feature.data.eyebrow}</p><h3 class="text-xl font-semibold tracking-tight">{feature.data.title}</h3><p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">{feature.data.summary}</p><span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold">Explore capability <Icon name="arrow" size={15} /></span></a>)}</div></div></section>

  <section class="bg-paper py-24 md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8"><div class="max-w-[700px]"><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-[#51710c] before:h-px before:w-6 before:bg-current">Built with a point of view</p><h2 class="text-4xl font-semibold leading-[1.05] tracking-[-.045em] md:text-5xl">Less infrastructure.<br />More ownership.</h2></div><div class="mt-16 border-t border-line">{home.principles.map((principle) => <article class="grid gap-4 border-b border-line py-8 md:grid-cols-[80px_1fr_1.35fr] md:items-start md:gap-10"><span class="font-mono text-xs text-muted">{principle.number}</span><h3 class="text-xl font-semibold tracking-tight">{principle.title}</h3><p class="max-w-lg text-sm leading-relaxed text-muted">{principle.text}</p></article>)}</div></div></section>

  <section class="bg-ink bg-[linear-gradient(rgba(255,255,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.025)_1px,transparent_1px)] bg-[size:48px_48px] py-20 text-white md:py-28"><div class="mx-auto grid w-full max-w-[1180px] items-end gap-10 px-5 sm:px-8 md:grid-cols-[1fr_auto]"><div><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-accent before:h-px before:w-6 before:bg-current">Ready when your repository is</p><h2 class="max-w-2xl text-4xl font-semibold leading-[1.05] tracking-[-.045em] md:text-5xl">{home.ctaTitle}</h2><p class="mt-5 max-w-xl text-white/55">{home.ctaText}</p></div><div class="md:text-right"><a class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent px-5 text-sm font-semibold text-ink transition hover:-translate-y-px hover:bg-[#e5ff91]" href="/docs/getting-started/">Read the quick start <Icon name="arrow" size={17} /></a><p class="mt-4 font-mono text-[10px] uppercase tracking-wider text-white/35">Experimental · v{site.currentVersion} · MIT</p></div></div></section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => button.addEventListener("click", async () => { await navigator.clipboard.writeText(button.dataset.copy ?? ""); button.classList.add("copied"); button.setAttribute("aria-label", "Copied"); window.setTimeout(() => button.classList.remove("copied"), 1400); }));
  </script>
</BaseLayout>
