---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import EditorPreview from "@/components/EditorPreview.astro";
import Icon from "@/components/Icon.astro";
import WorkflowPath from "@/components/WorkflowPath.astro";
import { getFeatures, getHome, getSite } from "@/lib/content";
const [home, site, features] = await Promise.all([getHome(), getSite(), getFeatures()]);
---

<BaseLayout>
  <section class="border-b border-line bg-paper">
    <div class="wrap grid items-start gap-14 py-16 md:py-24 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div class="lg:pt-6">
        <p class="eyebrow">{home.heroEyebrow}</p>
        <h1 class="display max-w-xl text-[2.3rem] leading-[1.1] sm:text-[42px]">{home.heroTitle}</h1>
        <p class="lead mt-6 max-w-lg">{home.heroSummary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href={home.primaryCta.href}>{home.primaryCta.label}</a>
          <a class="btn-secondary" href={home.secondaryCta.href} target="_blank" rel="noreferrer">
            <Icon name="github" size={17} /> {home.secondaryCta.label}
          </a>
        </div>
        <div class="mt-6 flex max-w-md items-center justify-between gap-3 rounded-lg border border-line bg-canvas py-2 pl-4 pr-2">
          <code class="overflow-hidden text-ellipsis whitespace-nowrap font-mono text-[11px] text-muted sm:text-xs">npm install @micacms/astro @micacms/model</code>
          <button class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-faint transition hover:bg-stone hover:text-ink [&.copied]:text-moss" data-copy="npm install @micacms/astro @micacms/model" aria-label="Copy install command">
            <Icon name="copy" size={15} />
          </button>
        </div>
        <a class="mt-6 inline-flex items-center gap-2 text-sm text-muted transition hover:text-ink" href={site.announcement.href}>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-ember"></span>{site.announcement.text}<Icon name="arrow" size={14} />
        </a>
      </div>
      <CodeWindow />
    </div>
  </section>

  <section class="border-b border-line bg-canvas">
    <div class="wrap grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {home.stats.map((stat) => (
        <div class="py-7 lg:py-8">
          <strong class="display block text-3xl">{stat.value}</strong>
          <span class="mt-1 block text-sm text-ink">{stat.label}</span>
          <small class="mt-0.5 block text-xs text-faint">{stat.note}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="section border-b border-line bg-paper">
    <div class="wrap grid gap-14 lg:grid-cols-[.85fr_1.15fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{home.problemEyebrow}</p>
        <h2 class="display max-w-md text-[30px] leading-[1.15]">{home.problemTitle}</h2>
        <p class="lead mt-5 max-w-md">{home.problemSummary}</p>
      </div>
      <WorkflowPath />
    </div>
  </section>

  <section class="section border-b border-line bg-canvas">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">From model to production</p>
        <h2 class="display text-[30px] leading-[1.15]">{home.workflowTitle}</h2>
        <p class="lead mt-5">{home.workflowSummary}</p>
      </div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
        {home.workflowSteps.map((step, index) => (
          <article class="bg-paper p-6 md:p-7">
            <span class="label-mono">Step {index + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
            <code class="mt-5 inline-block rounded-md border border-line bg-canvas px-2.5 py-1 font-mono text-[11px] text-muted">{step.detail}</code>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-b border-line bg-paper">
    <div class="wrap">
      <div class="grid items-end gap-8 md:grid-cols-[1fr_auto]">
        <div class="max-w-xl">
          <p class="eyebrow">For the people who write</p>
          <h2 class="display text-[30px] leading-[1.15]">A real editor, not a repository in nicer colours.</h2>
        </div>
        <p class="lead max-w-sm md:text-right">
          Model-generated forms give editors the controls they need. Validation happens before an entry reaches the repository.
        </p>
      </div>
      <div class="mt-12"><EditorPreview /></div>
      <div class="mt-6 grid gap-2 text-sm text-muted sm:grid-cols-2 lg:grid-cols-4">
        {["Focused field controls", "Markdoc rich text", "Media and relations", "Conflict protection"].map((item) => (
          <span class="flex items-center gap-2"><i class="text-moss"><Icon name="check" size={15} /></i>{item}</span>
        ))}
      </div>
    </div>
  </section>

  <section id="features" class="section border-b border-line bg-canvas">
    <div class="wrap">
      <div class="grid items-end gap-8 md:grid-cols-[1fr_auto]">
        <div class="max-w-xl">
          <p class="eyebrow">{home.featuresEyebrow}</p>
          <h2 class="display text-[30px] leading-[1.15]">{home.featuresTitle}</h2>
        </div>
        <p class="lead max-w-sm md:text-right">{home.featuresSummary}</p>
      </div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <a class="group flex flex-col bg-paper p-6 transition hover:bg-surface md:p-7" href={`/features/${feature.id}/`}>
            <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-canvas text-muted transition group-hover:border-line-strong group-hover:text-ember">
              <Icon name={feature.data.icon} size={18} />
            </span>
            <p class="label-mono mt-6">{feature.data.eyebrow}</p>
            <h3 class="mt-1.5 text-lg font-semibold text-ink">{feature.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{feature.data.summary}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm text-brand">
              Read more <i class="transition group-hover:translate-x-0.5"><Icon name="arrow" size={14} /></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-b border-line bg-paper">
    <div class="wrap">
      <div class="max-w-xl">
        <p class="eyebrow">Built with a point of view</p>
        <h2 class="display text-[30px] leading-[1.15]">Less infrastructure. More ownership.</h2>
      </div>
      <div class="mt-12 border-t border-line">
        {home.principles.map((principle) => (
          <article class="grid gap-3 border-b border-line py-7 md:grid-cols-[70px_1fr_1.4fr] md:items-start md:gap-10">
            <span class="label-mono md:pt-1">{principle.number}</span>
            <h3 class="text-lg font-semibold text-ink">{principle.title}</h3>
            <p class="max-w-lg text-sm leading-relaxed text-muted">{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-canvas">
    <div class="wrap grid items-end gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow">Ready when your repository is</p>
        <h2 class="display max-w-xl text-[30px] leading-[1.15]">{home.ctaTitle}</h2>
        <p class="lead mt-4 max-w-lg">{home.ctaText}</p>
      </div>
      <div class="md:text-right">
        <a class="btn-primary" href="/docs/getting-started/">Read the quick start <Icon name="arrow" size={16} /></a>
        <p class="mt-3 text-xs text-faint">Experimental · v{site.currentVersion} · MIT</p>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) =>
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.classList.add("copied");
        button.setAttribute("aria-label", "Copied");
        window.setTimeout(() => button.classList.remove("copied"), 1400);
      }),
    );
  </script>
</BaseLayout>
