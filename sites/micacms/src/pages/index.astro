---
import { ArrowRight, Check, Minus } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import EditorMock from "@/components/EditorMock.astro";
import Rocket from "@/components/Rocket.astro";
import StartPaths from "@/components/StartPaths.astro";
import Strata from "@/components/Strata.astro";
import { renderRichText } from "@micacms/astro";
import { getHome, getSite } from "@/lib/content";
const [home, site] = await Promise.all([getHome(), getSite()]);
const { hero, how, audiences, agents, run, fit, start } = home;
const lead = await renderRichText(hero.lead, home);
---

<BaseLayout>
  <section class="relative flex min-h-[calc(100svh-9rem)] flex-col overflow-hidden md:min-h-[calc(100svh-6.5rem)]">
    <div class="wrap relative flex flex-1 flex-col justify-center pt-14 pb-44 md:pt-20 md:pb-60">
      <a class="mb-8 inline-flex items-center gap-2 rounded-full border border-line bg-surface py-1 pr-3 pl-2.5 text-[14px] text-ink-muted transition hover:border-line-strong hover:text-ink" href={site.announcement.href}>
        <span class="h-2 w-2 rounded-full bg-glint ring-1 ring-on-glint ring-inset" aria-hidden="true"></span>
        {site.announcement.text}
        <ArrowRight size={14} aria-hidden="true" />
      </a>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="display-1 m-0 max-w-[21ch]">{hero.title}</h1>
      <div class="lead mt-6 max-w-xl [&_a]:font-medium [&_a]:text-primary [&_a]:underline [&_a]:decoration-primary/40 [&_a]:underline-offset-4 [&_a:hover]:text-primary-hover [&_p]:m-0" set:html={lead} />
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn-primary" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="btn-secondary" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
    <Rocket class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-[45%] lg:block" />
    <Strata class="absolute inset-x-0 bottom-0 h-40 md:h-56" sparkles={false} rise />
  </section>

  <section id="how-it-works" class="section scroll-mt-20 border-b border-line bg-surface">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">{how.eyebrow}</p>
        <h2 class="title-1 m-0">{how.title}</h2>
        <p class="lead mt-5">{how.lead}</p>
      </div>
      <ol class="m-0 mt-14 flex list-none flex-col gap-16 p-0 md:mt-20 md:gap-24">
        {how.steps.map((step, index) => (
          <li class="grid items-center gap-8 md:grid-cols-[5fr_7fr] md:gap-14">
            <div class="max-w-md">
              <span class="font-display text-[44px] leading-none font-extrabold text-primary" aria-hidden="true">{index + 1}</span>
              <h3 class="title-3 mt-4 mb-0">{step.title}</h3>
              <p class="mt-3 mb-0 text-ink-muted">{step.text}</p>
            </div>
            <div class="min-w-0">
              {step.visual === "editor" ? (
                <EditorMock />
              ) : (
                <CodeBlock file={step.file} code={step.code ?? ""} kind={step.visual === "change" ? "change" : "code"} />
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">{audiences.eyebrow}</p>
        <h2 class="title-1 m-0">{audiences.title}</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {audiences.groups.map((group) => (
          <article class="card flex flex-col gap-4 p-6 md:p-8">
            <h3 class="title-3 m-0">{group.title}</h3>
            <p class="m-0 text-ink-muted">{group.text}</p>
            <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
              {group.points.map((point) => (
                <li class="flex gap-2.5"><Check size={20} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />{point.text}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-t border-line bg-surface">
    <div class="wrap grid items-center gap-10 md:grid-cols-[7fr_5fr] md:gap-14">
      <div class="max-w-xl">
        <p class="eyebrow">{agents.eyebrow}</p>
        <h2 class="title-1 m-0">{agents.title}</h2>
        <p class="lead mt-5">{agents.lead}</p>
        <ul class="m-0 mt-6 flex list-none flex-col gap-2.5 p-0">
          {agents.points.map((point) => (
            <li class="flex gap-2.5"><Check size={20} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />{point.text}</li>
          ))}
        </ul>
        <a class="link mt-8 inline-flex items-center gap-1.5" href={agents.link.href}>{agents.link.label}<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <CodeBlock class="min-w-0" file={agents.file} code={agents.code ?? ""} />
    </div>
  </section>

  <section class="section border-y border-line bg-sandstone">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">{run.eyebrow}</p>
        <h2 class="title-1 m-0">{run.title}</h2>
        <p class="lead mt-5">{run.lead}</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {run.options.map((option) => (
          <article class="card flex flex-col gap-4 p-6 md:p-8">
            <span class="w-fit rounded-full bg-strata-soft px-2.5 py-0.5 text-[13px] leading-4.5 font-semibold text-ink">{option.audience}</span>
            <h3 class="title-3 m-0">{option.title}</h3>
            <p class="m-0 text-ink-muted">{option.text}</p>
            <code class="block overflow-x-auto rounded-sm bg-strata-soft px-3 py-2 font-mono text-[14px] whitespace-nowrap text-ink" tabindex="0">{option.command}</code>
            <div>
              <h4 class="m-0 text-[13px] font-semibold tracking-[.08em] text-ink-muted uppercase">{run.needsTitle}</h4>
              <ul class="m-0 mt-3 flex list-disc flex-col gap-1 pl-5 marker:text-ink-subtle">
                {option.needs.map((need) => <li>{need.text}</li>)}
              </ul>
            </div>
            <a class="link mt-auto inline-flex w-fit items-center gap-1.5 pt-2" href={option.link.href}>{option.link.label}<ArrowRight size={16} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">{fit.eyebrow}</p>
        <h2 class="title-1 m-0">{fit.title}</h2>
        <p class="lead mt-5">{fit.lead}</p>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-14">
        <div>
          <h3 class="title-3 m-0">{fit.goodTitle}</h3>
          <ul class="m-0 mt-5 flex list-none flex-col gap-3 p-0">
            {fit.good.map((item) => (
              <li class="flex gap-2.5"><Check size={20} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />{item.text}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="title-3 m-0">{fit.notTitle}</h3>
          <ul class="m-0 mt-5 flex list-none flex-col gap-3 p-0">
            {fit.not.map((item) => (
              <li class="flex gap-2.5 text-ink-muted"><Minus size={20} class="mt-0.5 shrink-0 text-ink-subtle" aria-hidden="true" />{item.text}</li>
            ))}
          </ul>
        </div>
      </div>
      <a class="link mt-10 inline-flex items-center gap-1.5" href={fit.link.href}>{fit.link.label}<ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="section border-t border-line bg-surface">
    <div class="wrap">
      <div class="max-w-2xl">
        <h2 class="title-1 m-0" id="start-title">{start.title}</h2>
        <p class="lead mt-5">{start.text}</p>
      </div>
      <div class="mt-10 max-w-4xl">
        <StartPaths paths={start.paths} labelledBy="start-title" />
      </div>
      <a class="btn-primary mt-10" href={start.link.href}>{start.link.label}<ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </section>
</BaseLayout>
