---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorPreview from "@/components/EditorPreview.astro";
import Icon from "@/components/Icon.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getFeatures, getProduct } from "@/lib/content";
const [product, features] = await Promise.all([getProduct(), getFeatures()]);
---

<BaseLayout title="Product" description={product.summary}>
  <PageHeader eyebrow={product.eyebrow} title={product.title} lead={product.summary}>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn-primary" href="/docs/getting-started/">Start with Mica <Icon name="arrow" size={16} /></a>
      <a class="btn-secondary" href="#capabilities">See all capabilities</a>
    </div>
  </PageHeader>

  <section class="section border-b border-line bg-canvas">
    <div class="wrap">
      <div class="max-w-xl">
        <p class="eyebrow">One system, three clear views</p>
        <h2 class="display text-[30px] leading-[1.15]">Good for the whole site team.</h2>
      </div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
        {product.audiences.map((audience) => (
          <article class="bg-surface p-6 md:p-7">
            <h3 class="text-lg font-semibold text-ink">{audience.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{audience.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-b border-line bg-surface">
    <div class="wrap">
      <div class="grid items-end gap-8 md:grid-cols-[1fr_auto]">
        <div class="max-w-xl">
          <p class="eyebrow">A clean work surface</p>
          <h2 class="display text-[30px] leading-[1.15]">The model does the busy work.</h2>
        </div>
        <p class="lead max-w-sm md:text-right">
          Add a collection or field in code. Mica reads the new model and updates the editing interface — no admin screen to build, no form schema to copy.
        </p>
      </div>
      <div class="mt-12"><EditorPreview /></div>
    </div>
  </section>

  <section id="capabilities" class="section border-b border-line bg-canvas">
    <div class="wrap">
      <div class="max-w-xl">
        <p class="eyebrow">Complete workflow</p>
        <h2 class="display text-[30px] leading-[1.15]">Every layer has one job.</h2>
      </div>
      <div class="mt-10 border-t border-line">
        {features.map((feature) => (
          <a class="group grid items-center gap-3 border-b border-line py-5 transition hover:bg-surface sm:grid-cols-[46px_1fr_1.5fr_20px]" href={`/features/${feature.id}/`}>
            <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-surface text-muted transition group-hover:text-accent">
              <Icon name={feature.data.icon} size={18} />
            </span>
            <h3 class="font-medium text-ink">{feature.data.title}</h3>
            <p class="text-sm text-muted max-sm:col-span-2">{feature.data.summary}</p>
            <span class="text-faint transition group-hover:translate-x-0.5 group-hover:text-accent max-sm:hidden"><Icon name="arrow" size={17} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-b border-line bg-surface">
    <div class="wrap grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-20">
      <div>
        <p class="eyebrow">What runs where</p>
        <h2 class="display max-w-sm text-[30px] leading-[1.15]">Small pieces with clean boundaries.</h2>
        <p class="lead mt-5 max-w-md">
          The public site gets no client library. It receives the static output that Astro already makes.
        </p>
      </div>
      <div class="border-t border-line">
        {product.stack.map((item) => (
          <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[1fr_1.2fr] sm:gap-4">
            <code class="font-mono text-xs text-ink">{item.name}</code>
            <span class="text-sm text-muted">{item.role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-canvas py-14">
    <div class="wrap grid items-center gap-6 md:grid-cols-[1fr_auto]">
      <div>
        <p class="flex items-center gap-2 text-xs text-muted">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span> Open source and experimental
        </p>
        <h2 class="display mt-2 text-[1.5rem] leading-snug">Inspect every decision before you adopt it.</h2>
      </div>
      <a class="btn-secondary" href="https://github.com/micacms/mica">Read the source <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</BaseLayout>
