---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" noindex>
  <section class="grid min-h-[70vh] place-items-center bg-ink bg-[linear-gradient(rgba(255,255,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.025)_1px,transparent_1px)] bg-[size:48px_48px] px-5 text-center text-white"><div><span class="font-mono text-sm text-accent">404</span><h1 class="mt-4 max-w-2xl text-4xl font-semibold leading-tight tracking-[-.045em] md:text-6xl">This file is not in the repository.</h1><p class="mb-8 mt-4 text-white/50">The address does not match a page on micacms.com.</p><a class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-ink transition hover:-translate-y-px hover:bg-[#e5ff91]" href="/">Return home</a></div></section>
</BaseLayout>
