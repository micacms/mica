---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" noindex>
  <section class="grid min-h-[65vh] place-items-center bg-paper px-5 text-center">
    <div>
      <p class="label-mono">404</p>
      <h1 class="display mt-3 max-w-xl text-[2rem] leading-[1.15] md:text-[2.6rem]">This file is not in the repository.</h1>
      <p class="lead mb-8 mt-4">The address does not match a page on micacms.com.</p>
      <a class="btn-primary" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
