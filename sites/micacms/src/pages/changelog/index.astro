---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RichText from "@/components/RichText.astro";
import { formatDate, getReleases, getSite } from "@/lib/content";
const [releases, site] = await Promise.all([getReleases(), getSite()]);
---

<BaseLayout title="Changelog" description="Product releases and changes in MicaCMS.">
  <section class="bg-ink bg-[linear-gradient(rgba(255,255,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.025)_1px,transparent_1px)] bg-[size:48px_48px] py-24 text-white md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8"><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-accent before:h-px before:w-6 before:bg-current">Changelog</p><h1 class="max-w-4xl text-5xl font-semibold leading-[.98] tracking-[-.055em] md:text-7xl">What changed, and why.</h1><p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/60">Mica releases all packages and the CMS together. The project is pre-1.0, so read the note before each upgrade.</p></div></section>
  <section class="bg-paper py-24 md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8">{releases.map((release, index) => <article class:list={["grid gap-8 border-t border-line py-14 md:grid-cols-[210px_1fr] md:gap-16", index === 0 && "border-t-0 pt-0"]}><aside class="flex flex-wrap content-start items-center gap-3 md:block"><span class="inline-block rounded-md bg-ink px-2.5 py-1 font-mono text-xs font-semibold text-white">v{release.data.version}</span><time class="text-xs text-muted md:mt-3 md:block" datetime={release.data.publishDate}>{formatDate(release.data.publishDate)}</time>{release.data.latest && <b class="flex items-center gap-2 text-[10px] font-medium text-muted md:mt-5"><span class="inline-block h-2 w-2 rounded-full bg-accent-deep shadow-[0_0_0_4px_rgba(169,219,34,.12)]"></span> Current</b>}</aside><div><h2 class="text-3xl font-semibold tracking-[-.035em]">{release.data.title}</h2><p class="mb-8 mt-3 max-w-2xl text-lg leading-relaxed text-muted">{release.data.summary}</p><RichText text={release.data.body} /></div></article>)}<div class="mt-8 rounded-xl border border-line bg-cream p-6 text-sm text-muted">The complete source changelog is in the repository. <a class="ml-1 font-semibold text-ink" href={`${site.githubUrl}/blob/main/CHANGELOG.md`}>Read CHANGELOG.md →</a></div></div></section>
</BaseLayout>
