---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import RichText from "@/components/RichText.astro";
import { LocationMap } from "@micacms/astro/components";
import { getImprint } from "@/lib/content";
const imprint = await getImprint();
---

<BaseLayout
  title={imprint.title}
  description="Who is responsible for micacms.com, and how to get in touch."
>
  <PageHeader eyebrow={imprint.eyebrow} title={imprint.title} lead={imprint.lead} />

  <section class="section">
    <div class="wrap grid gap-10 md:grid-cols-[190px_1fr] md:gap-14">
      <h2 class="title-3 m-0">Responsible</h2>
      <div class="max-w-2xl">
        <address class="text-[17px] leading-relaxed text-ink not-italic">
          {imprint.entityName}<br />
          {imprint.street}<br />
          {imprint.postalCode} {imprint.city}<br />
          {imprint.country}
        </address>
        {imprint.location && (
          <LocationMap
            place={imprint.location}
            map="liberty"
            label={`Map: ${imprint.city}`}
            class="mt-6 block h-72 w-full overflow-hidden rounded-lg border border-line bg-surface"
          />
        )}
        <p class="mt-5">
          <a class="link" href={`mailto:${imprint.email}`}>{imprint.email}</a>
        </p>

        {imprint.sections.map((section) => (
          <div class="mt-12 border-t border-line pt-10">
            <h2 class="title-3 mt-0 mb-3">{section.title}</h2>
            <RichText text={section.body} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
