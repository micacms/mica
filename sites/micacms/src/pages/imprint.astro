---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import RichText from "@/components/RichText.astro";
import { getImprint } from "@/lib/content";
const imprint = await getImprint();
---

<BaseLayout
  title={imprint.title}
  description="Who is responsible for micacms.com, and how to get in touch."
>
  <PageHeader eyebrow={imprint.eyebrow} title={imprint.title} lead={imprint.lead} />

  <section class="section bg-paper">
    <div class="wrap grid gap-10 md:grid-cols-[190px_1fr] md:gap-14">
      <h2 class="text-lg font-semibold text-ink">Responsible</h2>
      <div class="max-w-2xl">
        <address class="text-[15px] not-italic leading-relaxed text-ink-soft">
          {imprint.entityName}<br />
          {imprint.street}<br />
          {imprint.postalCode} {imprint.city}<br />
          {imprint.country}
        </address>
        <p class="mt-5 text-[15px]">
          <a class="font-medium text-brand underline decoration-brand/30 underline-offset-4 transition hover:decoration-brand" href={`mailto:${imprint.email}`}>{imprint.email}</a>
        </p>

        {imprint.sections.map((section) => (
          <div class="mt-12 border-t border-line pt-10">
            <h2 class="mb-3 text-lg font-semibold text-ink">{section.title}</h2>
            <RichText text={section.body} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
