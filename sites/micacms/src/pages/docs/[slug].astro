---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowLeft, ArrowRight, Clock3 } from "@lucide/astro";
import RichText from "@/components/RichText.astro";
import { DOC_SECTIONS, getDocs } from "@/lib/content";
export async function getStaticPaths() { return (await getCollection("docs")).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const docs = await getDocs();
const index = docs.findIndex((doc) => doc.id === entry.id);
const previous = index > 0 ? docs[index - 1] : null;
const next = index < docs.length - 1 ? docs[index + 1] : null;
const sections = DOC_SECTIONS.filter((section) => docs.some((doc) => doc.data.section === section.key));
const sectionLabel = DOC_SECTIONS.find((section) => section.key === entry.data.section)?.label ?? entry.data.section;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="wrap grid min-h-screen lg:grid-cols-[230px_1fr] lg:gap-14">
    <aside class="hidden border-r border-line py-12 pr-7 lg:block" aria-label="Documentation">
      <a class="mb-7 block text-[15px] font-semibold text-ink" href="/docs/">Documentation</a>
      {sections.map((section) => (
        <div class="mb-7">
          <span class="mb-3 block px-3 text-[13px] font-semibold tracking-[.08em] text-ink-subtle uppercase">{section.label}</span>
          {docs.filter((doc) => doc.data.section === section.key).map((doc) => (
            <a
              class:list={[
                "mb-0.5 block rounded-md px-3 py-1.5 text-[15px] text-ink-muted transition hover:bg-surface hover:text-ink",
                doc.id === entry.id && "bg-primary-soft font-semibold !text-ink",
              ]}
              href={`/docs/${doc.id}/`}
              aria-current={doc.id === entry.id ? "page" : undefined}
            >{doc.data.title}</a>
          ))}
        </div>
      ))}
    </aside>
    <article class="min-w-0 max-w-3xl py-12 md:py-16">
      <div class="mb-8 flex gap-2 text-[14px] text-ink-subtle">
        <a class="transition hover:text-ink" href="/docs/">Docs</a><span>/</span><span>{entry.data.title}</span>
      </div>
      <header class="mb-10 border-b border-line pb-9">
        <p class="eyebrow">{sectionLabel}</p>
        <h1 class="title-1 m-0">{entry.data.title}</h1>
        <p class="lead mt-5 max-w-2xl">{entry.data.summary}</p>
        <span class="mt-5 flex items-center gap-1.5 text-[14px] text-ink-subtle">
          <Clock3 size={14} aria-hidden="true" /> {entry.data.readTime} min read
        </span>
      </header>
      <RichText text={entry.data.body} images={entry.data._mica.images} />
      <nav class="mt-14 grid grid-cols-2 gap-4 border-t border-line pt-7" aria-label="Documentation pages">
        {previous ? (
          <a class="card p-4 transition hover:border-line-strong" href={`/docs/${previous.id}/`}>
            <span class="block text-[13px] text-ink-subtle">Previous</span>
            <strong class="mt-1 flex items-center gap-1.5 text-[15px] font-semibold text-ink"><ArrowLeft size={15} aria-hidden="true" /> {previous.data.title}</strong>
          </a>
        ) : <i></i>}
        {next && (
          <a class="card p-4 text-right transition hover:border-line-strong" href={`/docs/${next.id}/`}>
            <span class="block text-[13px] text-ink-subtle">Next</span>
            <strong class="mt-1 flex items-center justify-end gap-1.5 text-[15px] font-semibold text-ink">{next.data.title} <ArrowRight size={15} aria-hidden="true" /></strong>
          </a>
        )}
      </nav>
    </article>
  </div>
</BaseLayout>
