---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getDocs } from "@/lib/content";
const docs = await getDocs();
const sections = [
  { key: "start", label: "Start here" },
  { key: "build", label: "Build" },
  { key: "operate", label: "Operate" },
];
---

<BaseLayout title="Documentation" description="Learn how to add Mica to Astro, define content, and run the editor.">
  <PageHeader
    eyebrow="Documentation"
    title="Build the content layer you can keep."
    lead="Start locally, understand the model, and take the same files to production."
  >
    <div class="mt-8 flex max-w-md items-center gap-3 rounded-lg border border-line bg-canvas px-4 py-2.5 text-muted">
      <span aria-hidden="true">⌕</span>
      <input class="min-w-0 flex-1 border-0 bg-transparent text-sm text-ink outline-none placeholder:text-faint" type="search" placeholder="Filter guides" aria-label="Filter documentation" data-doc-search />
      <kbd class="rounded border border-line-strong px-1.5 py-0.5 font-mono text-[10px] text-faint">/</kbd>
    </div>
  </PageHeader>

  <section class="section bg-paper">
    <div class="wrap">
      {sections.map((section, index) => (
        <div class:list={["grid gap-6 border-t border-line py-10 md:grid-cols-[190px_1fr] md:gap-10", index === 0 && "border-t-0 pt-0"]}>
          <h2 class="text-lg font-semibold text-ink">{section.label}</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {docs.filter((doc) => doc.data.section === section.key).map((doc) => (
              <a
                class="card p-5 transition hover:border-line-strong hover:bg-canvas"
                href={`/docs/${doc.id}/`}
                data-doc-card
                data-title={`${doc.data.title} ${doc.data.summary}`}
              >
                <span class="label-mono">{doc.data.readTime} min read</span>
                <h3 class="mt-3 text-lg font-semibold text-ink">{doc.data.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{doc.data.summary}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="py-14 text-center text-muted" data-no-results hidden>No guide matches this filter.</p>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("[data-doc-search]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-doc-card]")];
    const empty = document.querySelector<HTMLElement>("[data-no-results]");
    search?.addEventListener("input", () => {
      const value = search.value.toLowerCase().trim();
      let shown = 0;
      cards.forEach((card) => {
        const match = (card.dataset.title ?? "").toLowerCase().includes(value);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
    window.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== search) {
        event.preventDefault();
        search?.focus();
      }
    });
  </script>
</BaseLayout>
