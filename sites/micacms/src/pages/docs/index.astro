---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Search } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import { DOC_SECTIONS, getDocs, getPages } from "@/lib/content";
const [docs, pages] = await Promise.all([getDocs(), getPages()]);
const index = pages.docs;
// A section with no page yet is not shown.
const sections = DOC_SECTIONS.filter((section) => docs.some((doc) => doc.data.section === section.key));
---

<BaseLayout title="Documentation" description="Learn how to add Mica to Astro, define content, and run the editor.">
  <PageHeader eyebrow={index.eyebrow} title={index.title} lead={index.lead}>
    <div class="mt-8 flex max-w-md items-center gap-3 rounded-md border border-line-strong bg-surface px-4 py-2.5 text-ink-subtle focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-strata">
      <Search size={18} aria-hidden="true" />
      <input class="min-w-0 flex-1 border-0 bg-transparent text-[15px] text-ink outline-none placeholder:text-ink-subtle" type="search" placeholder={index.filterLabel} aria-label={index.filterLabel} data-doc-search />
      <kbd class="rounded-sm border border-line-strong px-1.5 py-0.5 font-mono text-[12px] text-ink-subtle">/</kbd>
    </div>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      {sections.map((section, index) => (
        <div class:list={["grid gap-6 border-t border-line py-10 md:grid-cols-[190px_1fr] md:gap-10", index === 0 && "border-t-0 pt-0"]}>
          <h2 class="title-3 m-0">{section.label}</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {docs.filter((doc) => doc.data.section === section.key).map((doc) => (
              <a
                class="card p-5 transition hover:border-line-strong"
                href={`/docs/${doc.id}/`}
                data-doc-card
                data-title={`${doc.data.title} ${doc.data.summary}`}
              >
                <span class="text-[13px] text-ink-subtle">{doc.data.readTime} min read</span>
                <h3 class="mt-2 mb-0 font-sans text-[18px] font-semibold text-ink">{doc.data.title}</h3>
                <p class="mt-1.5 mb-0 text-[15px] leading-relaxed text-ink-muted">{doc.data.summary}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="py-14 text-center text-ink-muted" data-no-results hidden>{index.noResults}</p>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("[data-doc-search]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-doc-card]")];
    const empty = document.querySelector<HTMLElement>("[data-no-results]");
    search?.addEventListener("input", () => {
      const value = search.value.toLowerCase().trim();
      let shown = 0;
      cards.forEach((card) => {
        const match = (card.dataset.title ?? "").toLowerCase().includes(value);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
    window.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== search) {
        event.preventDefault();
        search?.focus();
      }
    });
  </script>
</BaseLayout>
