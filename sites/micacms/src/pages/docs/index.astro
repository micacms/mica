---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { getDocs } from "@/lib/content";
const docs = await getDocs();
const sections = [{ key: "start", label: "Start here", number: "01" }, { key: "build", label: "Build", number: "02" }, { key: "operate", label: "Operate", number: "03" }];
---

<BaseLayout title="Documentation" description="Learn how to add Mica to Astro, define content, and run the editor.">
  <section class="bg-ink bg-[linear-gradient(rgba(255,255,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.025)_1px,transparent_1px)] bg-[size:48px_48px] py-20 text-white md:py-28"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8"><p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.14em] text-accent before:h-px before:w-6 before:bg-current">Documentation</p><h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-[-.05em] md:text-7xl">Build the content layer you can keep.</h1><p class="mt-6 max-w-2xl text-lg text-white/55">Start locally, understand the model, and take the same files to production.</p><div class="mt-10 flex max-w-xl items-center gap-3 rounded-lg border border-white/15 bg-white/[.07] px-4 py-3 text-white/45"><span class="text-xl">⌕</span><input class="min-w-0 flex-1 border-0 bg-transparent text-sm text-white outline-none placeholder:text-white/30" type="search" placeholder="Filter guides" aria-label="Filter documentation" data-doc-search /><kbd class="rounded border border-white/15 px-2 py-0.5 font-mono text-[10px]">/</kbd></div></div></section>
  <section class="bg-paper py-24 md:py-32"><div class="mx-auto w-full max-w-[1180px] px-5 sm:px-8">{sections.map((section, index) => <div class:list={["grid gap-8 border-t border-line py-10 md:grid-cols-[200px_1fr]", index === 0 && "border-t-0 pt-0"]}><div class="flex gap-4"><span class="font-mono text-[10px] text-muted">{section.number}</span><h2 class="text-xl font-semibold">{section.label}</h2></div><div class="grid gap-4 sm:grid-cols-2">{docs.filter((doc) => doc.data.section === section.key).map((doc) => <a class="rounded-xl border border-line bg-white p-6 transition hover:-translate-y-1 hover:border-[#aeb7a7] hover:shadow-lg" href={`/docs/${doc.id}/`} data-doc-card data-title={`${doc.data.title} ${doc.data.summary}`}><div class="flex justify-between font-mono text-[10px] uppercase tracking-wider text-muted"><span>{doc.data.readTime} min read</span><Icon name="arrow" size={17} /></div><h3 class="mt-10 text-xl font-semibold tracking-tight">{doc.data.title}</h3><p class="mt-2 text-sm leading-relaxed text-muted">{doc.data.summary}</p></a>)}</div></div>)}<p class="py-16 text-center text-muted" data-no-results hidden>No guide matches this filter.</p></div></section>
  <script>
    const search = document.querySelector<HTMLInputElement>("[data-doc-search]"); const cards = [...document.querySelectorAll<HTMLElement>("[data-doc-card]")]; const empty = document.querySelector<HTMLElement>("[data-no-results]");
    search?.addEventListener("input", () => { const value = search.value.toLowerCase().trim(); let shown = 0; cards.forEach((card) => { const match = (card.dataset.title ?? "").toLowerCase().includes(value); card.hidden = !match; if (match) shown++; }); if (empty) empty.hidden = shown > 0; });
    window.addEventListener("keydown", (event) => { if (event.key === "/" && document.activeElement !== search) { event.preventDefault(); search?.focus(); } });
  </script>
</BaseLayout>
