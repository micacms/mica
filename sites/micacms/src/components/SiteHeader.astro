---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { getNavigation, getSite } from "@/lib/content";
const [navigation, site] = await Promise.all([getNavigation(), getSite()]);
const current = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 text-white backdrop-blur-xl">
  <div class="mx-auto flex h-[68px] w-full max-w-[1180px] items-center justify-between px-5 sm:px-8">
    <Logo />
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      {navigation.main.map((item) => <a class:list={["text-sm text-white/65 transition hover:text-white", isActive(item.href) && "text-white"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a class="flex items-center gap-2 px-2 text-sm text-white/70 transition hover:text-white" href={site.githubUrl} target="_blank" rel="noreferrer"><Icon name="github" size={18} /><span>GitHub</span></a>
      <a class="inline-flex min-h-9 items-center justify-center gap-2 rounded-md bg-accent px-3.5 text-xs font-semibold text-ink transition hover:-translate-y-px hover:bg-[#e5ff91]" href="/docs/getting-started/">Get started <Icon name="arrow" size={16} /></a>
    </div>
    <details class="group relative md:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-white/15 [&::-webkit-details-marker]:hidden" aria-label="Open navigation"><Icon name="menu" size={22} /></summary>
      <nav class="absolute right-0 top-12 flex min-w-56 flex-col rounded-lg border border-white/10 bg-ink-soft p-2 shadow-2xl" aria-label="Mobile navigation">
        {navigation.main.map((item) => <a class="rounded-md px-4 py-3 text-sm text-white/75 hover:bg-white/10 hover:text-white" href={item.href}>{item.label}</a>)}
        <a class="rounded-md px-4 py-3 text-sm text-white/75 hover:bg-white/10 hover:text-white" href={site.githubUrl}>GitHub</a>
        <a class="rounded-md px-4 py-3 text-sm text-white/75 hover:bg-white/10 hover:text-white" href="/docs/getting-started/">Get started</a>
      </nav>
    </details>
  </div>
</header>
