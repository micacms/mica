---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { getNavigation, getSite } from "@/lib/content";
const [navigation, site] = await Promise.all([getNavigation(), getSite()]);
const current = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between">
    <Logo />
    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {navigation.main.map((item) => (
        <a
          class:list={[
            "text-sm text-muted transition hover:text-ink",
            isActive(item.href) && "font-medium !text-ink",
          ]}
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <div class="hidden items-center gap-4 md:flex">
      <a class="flex items-center gap-2 text-sm text-muted transition hover:text-ink" href={site.githubUrl} target="_blank" rel="noreferrer">
        <Icon name="github" size={17} /><span>GitHub</span>
      </a>
      <a class="btn-primary" href="/docs/getting-started/">Get started</a>
    </div>
    <details class="group relative md:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-line-strong [&::-webkit-details-marker]:hidden" aria-label="Open navigation">
        <Icon name="menu" size={20} />
      </summary>
      <nav class="card absolute right-0 top-12 flex min-w-56 flex-col p-2 shadow-lg" aria-label="Mobile navigation">
        {navigation.main.map((item) => (
          <a class="rounded-md px-3 py-2.5 text-sm text-muted hover:bg-canvas hover:text-ink" href={item.href}>{item.label}</a>
        ))}
        <a class="rounded-md px-3 py-2.5 text-sm text-muted hover:bg-canvas hover:text-ink" href={site.githubUrl}>GitHub</a>
        <a class="rounded-md px-3 py-2.5 text-sm font-medium text-ink hover:bg-canvas" href="/docs/getting-started/">Get started</a>
      </nav>
    </details>
  </div>
</header>
