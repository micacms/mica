---
import {
  ArrowRight, Check, Clock3, CodeXml, Copy, ExternalLink, FileImage,
  GitBranch, GitFork, Menu, PanelsTopLeft, PencilLine, RotateCcwClock, ShieldCheck,
} from "@lucide/astro";

interface Props { name: string; size?: number; strokeWidth?: number; }
const { name, size = 20, strokeWidth = 1.8 } = Astro.props;
const icons: Record<string, typeof ArrowRight> = {
  repository: GitBranch, model: CodeXml, edit: PencilLine, history: RotateCcwClock,
  image: FileImage, shield: ShieldCheck, arrow: ArrowRight, check: Check,
  github: GitFork, menu: Menu, external: ExternalLink, clock: Clock3,
  copy: Copy, panels: PanelsTopLeft,
};
const LucideIcon = icons[name] ?? ArrowRight;
---

<LucideIcon size={size} stroke-width={strokeWidth} aria-hidden="true" />
