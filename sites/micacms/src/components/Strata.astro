---
/**
 * Layers of rock: the website's one illustration, in the hero and in the footer (brand guide, "Strata").
 * Each band's top edge is a sum of sine waves whose periods divide the width, so the edge
 * repeats every WIDTH units. With `rise`, Motion lifts the layers into place from the bottom,
 * the deepest first, and spreads them upward as their section scrolls away.
 */
/** `seed` shifts the waves, so that two strata on one page do not look the same. */
interface Props { class?: string; sparkles?: boolean; rise?: boolean; seed?: number; }
const { class: className, sparkles = true, rise = false, seed = 0 } = Astro.props;

const WIDTH = 1440;
const HEIGHT = 200;
const STEP = 40;

/** [amplitude, waves per width, phase] */
type Wave = [number, number, number];
const BANDS: { fill: string; base: number; waves: Wave[] }[] = [
  { fill: "fill-band-glint", base: 92, waves: [[10, 1, 0.3], [5, 3, 1.7], [2, 5, 4.1]] },
  { fill: "fill-band-sand", base: 118, waves: [[8, 1, 2.2], [4, 2, 0.6], [2, 4, 3.3]] },
  { fill: "fill-band-malachite", base: 144, waves: [[7, 1, 4.5], [4, 3, 2.9], [1.5, 6, 0.4]] },
  { fill: "fill-band-blue", base: 166, waves: [[6, 2, 1.1], [3, 3, 5.2]] },
  { fill: "fill-band-shale", base: 185, waves: [[4, 1, 3.8], [2, 4, 1.4]] },
];

function edge(base: number, waves: Wave[], x: number): number {
  return waves.reduce((y, [amplitude, count, phase]) => y + amplitude * Math.sin((2 * Math.PI * count * x) / WIDTH + phase + seed * count), base);
}

/** A closed band: a smooth top edge (Catmull-Rom as cubic Béziers), filled to the bottom. */
function bandPath(base: number, waves: Wave[]): string {
  const points: [number, number][] = [];
  for (let x = -STEP; x <= WIDTH + STEP; x += STEP) points.push([x, edge(base, waves, x)]);
  const round = (value: number) => Math.round(value * 10) / 10;
  let d = `M${round(points[1]![0])} ${round(points[1]![1])}`;
  for (let i = 1; i < points.length - 2; i++) {
    const [p0, p1, p2, p3] = [points[i - 1]!, points[i]!, points[i + 1]!, points[i + 2]!];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${round(c1[0]!)} ${round(c1[1]!)} ${round(c2[0]!)} ${round(c2[1]!)} ${round(p2[0])} ${round(p2[1])}`;
  }
  return `${d}L${WIDTH} ${HEIGHT}L0 ${HEIGHT}Z`;
}

const bands = BANDS.map((band) => ({ ...band, d: bandPath(band.base, band.waves) }));
---

{/* The bands stretch with the width; the sparkles sit on top in their own drawing, so they keep their shape. */}
<div class:list={["grid w-full [&>*]:col-start-1 [&>*]:row-start-1", className]} aria-hidden="true" data-strata data-rise={rise ? "" : undefined}>
  <svg class="block h-full w-full" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="none">
    {bands.map((band) => (
      <g data-strata-layer>
        <path class={band.fill} d={band.d} />
      </g>
    ))}
  </svg>
  {sparkles && (
    <svg class="mt-[1%] mr-[10%] h-auto w-12 self-start justify-self-end fill-glint md:w-16" viewBox="0 0 80 64">
      <path d="M20 2 l6 13 l13 6 l-13 6 l-6 13 l-6 -13 l-13 -6 l13 -6 z" />
      <path d="M64 40 l4 8 l8 4 l-8 4 l-4 8 l-4 -8 l-8 -4 l8 -4 z" />
    </svg>
  )}
</div>
{rise && (
  <script is:inline>
    // Before the first paint: lower the layers so that they can rise. The timer is a fallback if Motion never loads.
    (function (strata) {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      strata.setAttribute("data-pending", "");
      setTimeout(function () { strata.removeAttribute("data-pending"); }, 4000);
    })(document.currentScript.previousElementSibling);
  </script>
)}

<style>
  [data-pending] [data-strata-layer] > path {
    transform: translateY(48px);
  }
</style>

<script>
  // The footer strata on every page stays still: load Motion only where the layers rise.
  const rising = document.querySelectorAll<HTMLElement>("[data-strata][data-rise]");
  if (rising.length > 0 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const { animate, scroll, stagger } = await import("motion");
    rising.forEach((strata) => {
      const section = strata.closest("section");
      const layers = [...strata.querySelectorAll<SVGGElement>("[data-strata-layer]")];
      const bands = layers.map((layer) => layer.querySelector<SVGPathElement>("path")!);
      // Laid down from the bottom up: the deepest layer rises first.
      animate(bands, { y: [48, 0] }, { duration: 1.1, ease: [0.2, 0.8, 0.2, 1], delay: stagger(0.12, { from: "last" }) });
      strata.removeAttribute("data-pending");
      if (section) {
        layers.forEach((layer, index) => {
          // The upper layers rise more, so the stack opens up as the hero scrolls away.
          scroll(animate(layer, { y: [0, -(layers.length - index) * 7] }, { ease: "linear" }), {
            target: section,
            offset: ["start start", "end start"],
          });
        });
      }
    });
  }
</script>
