---
import { renderRichText } from "@micacms/astro";
interface Props { text: string | null; class?: string; }
const { text, class: className } = Astro.props;
const html = renderRichText(text);
---

{html && <div class:list={[
  "max-w-3xl text-[16px] leading-[1.8] text-[#38413b] [&>*+*]:mt-5",
  "[&_h2]:mt-14 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:tracking-[-.035em] [&_h2]:text-ink",
  "[&_h3]:mt-10 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:tracking-tight [&_h3]:text-ink",
  "[&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6",
  "[&_a]:font-medium [&_a]:underline [&_a]:decoration-[#789d26] [&_a]:underline-offset-4 [&_strong]:font-semibold [&_strong]:text-ink",
  "[&_blockquote]:my-8 [&_blockquote]:border-l-2 [&_blockquote]:border-accent-deep [&_blockquote]:pl-6 [&_blockquote]:text-lg [&_blockquote]:text-muted",
  "[&_pre]:my-7 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-white/10 [&_pre]:bg-ink [&_pre]:p-5 [&_pre]:text-sm [&_pre]:leading-relaxed [&_pre]:text-white/75 [&_pre]:shadow-lg",
  "[&_pre_code]:font-mono [&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-[#e9ece4] [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[.86em] [&_:not(pre)>code]:text-ink",
  className,
]} set:html={html} />}
