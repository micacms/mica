---
import { getSite } from "@/lib/content";
const site = await getSite();
---

{/*
  Scrolls away with the page rather than sitting inside the sticky header: the
  warning has to be seen, but it should not eat viewport height on every screen.
  Not dismissible — a disclaimer you can click away stops being a disclaimer.
*/}
<div class="border-b border-line bg-ember-soft">
  <p class="wrap flex flex-wrap items-center justify-center gap-x-2 gap-y-1 py-2 text-center text-xs text-ink-soft">
    <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-ember" aria-hidden="true"></span>
    <strong class="font-medium">Under development</strong>
    <span>
      Mica is experimental at v{site.currentVersion} and not ready for production.
      <a class="underline decoration-ember/40 underline-offset-2 transition hover:decoration-ember" href="/changelog/">Follow the releases</a>.
    </span>
  </p>
</div>
