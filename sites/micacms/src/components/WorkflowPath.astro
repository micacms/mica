---
import Icon from "./Icon.astro";

const steps = [
  { key: "EDITOR", icon: "edit", title: "Someone writes in Mica", detail: "generated forms" },
  { key: "SOURCE", icon: "repository", title: "Your repository", detail: "content/", current: true },
  { key: "BUILD", icon: "model", title: "Astro reads local files", detail: "getCollection()" },
  { key: "OUTPUT", icon: "panels", title: "Static files on any host", detail: "HTML + CSS + assets" },
];
---

<div class="overflow-hidden rounded-md border border-line bg-surface">
  <ol>
    {steps.map((step, index) => (
      <li class:list={[
        "relative grid grid-cols-[40px_1fr] items-center gap-4 px-5 py-5 sm:grid-cols-[40px_1fr_auto] sm:px-6",
        index > 0 && "border-t border-line",
      ]}>
        {step.current && <span class="absolute inset-y-3 left-0 w-0.5 bg-ember" aria-hidden="true"></span>}
        <span class="flex h-10 w-10 items-center justify-center rounded-sm border border-line bg-canvas text-muted">
          <Icon name={step.icon} size={18} />
        </span>
        <div class="min-w-0">
          <small class="label-mono block">{String(index + 1).padStart(2, "0")} · {step.key}</small>
          <strong class="block text-[15px] font-medium text-ink">{step.title}</strong>
        </div>
        <code class="col-start-2 font-mono text-[11px] text-faint sm:col-start-auto">{step.detail}</code>
      </li>
    ))}
  </ol>
  <p class="flex items-center justify-center gap-2 border-t border-line bg-canvas px-5 py-3.5 text-xs text-muted">
    <span class="text-moss"><Icon name="check" size={14} /></span> The published website never contacts Mica.
  </p>
</div>
