---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import RichText from "@/components/RichText.astro";
import { formatDate, getPages, getReleases, getSite } from "@/lib/content";
const [releases, site, pages] = await Promise.all([getReleases(), getSite(), getPages()]);
const { changelog } = pages;
---

<BaseLayout title={changelog.title} description="Product releases and changes in Mica.">
  <PageHeader
    eyebrow={changelog.eyebrow}
    title={changelog.title}
    lead={changelog.lead}
  />
  <section class="section">
    <div class="wrap">
      {releases.map((release, index) => (
        <article class:list={["grid gap-6 border-t border-line py-12 md:grid-cols-[190px_1fr] md:gap-14", index === 0 && "border-t-0 pt-0"]}>
          <aside class="flex flex-wrap content-start items-center gap-3 md:block">
            <span class="inline-block rounded-sm bg-strata-soft px-2.5 py-1 font-mono text-[14px] font-medium text-ink">v{release.data.version}</span>
            <time class="text-[14px] text-ink-muted md:mt-3 md:block" datetime={release.data.publishDate}>{formatDate(release.data.publishDate)}</time>
            {release.data.latest && (
              <b class="inline-flex w-fit items-center gap-2 rounded-full bg-primary-soft py-0.5 pr-2.5 pl-2 text-[13px] leading-4.5 font-semibold text-ink md:mt-4 md:flex">
                <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span> {changelog.currentLabel}
              </b>
            )}
          </aside>
          <div>
            <h2 class="title-2 m-0">{release.data.title}</h2>
            <p class="lead mt-3 mb-7 max-w-2xl">{release.data.summary}</p>
            <RichText text={release.data.body} from={release.data} />
          </div>
        </article>
      ))}
      <div class="mt-6 rounded-md bg-strata-soft p-5 text-[15px] text-ink">
        {changelog.sourceNote}
        <a class="link ml-1" href={`${site.githubUrl}/releases`}>{changelog.sourceLink}</a>
      </div>
    </div>
  </section>
</BaseLayout>
