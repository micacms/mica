---
import { ExternalLink, Menu } from "@lucide/astro";
import Logo from "./Logo.astro";
import { getNavigation, getSite } from "@/lib/content";
const [navigation, site] = await Promise.all([getNavigation(), getSite()]);
const current = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-ground/90 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <Logo />
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {navigation.main.map((item) => (
        <a
          class:list={[
            "rounded-full px-3.5 py-1.5 text-[15px] font-medium text-ink-muted transition hover:text-ink",
            isActive(item.href) && "bg-primary-soft !text-ink",
          ]}
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
        >{item.label}</a>
      ))}
      <a class="flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[15px] font-medium text-ink-muted transition hover:text-ink" href={site.githubUrl}>
        GitHub<ExternalLink size={14} aria-hidden="true" />
      </a>
    </nav>
    <a class="btn-primary hidden min-h-10 py-2 md:inline-flex" href="/docs/getting-started/">Get started</a>
    <details class="group relative md:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-line-strong [&::-webkit-details-marker]:hidden" aria-label="Open navigation">
        <Menu size={20} aria-hidden="true" />
      </summary>
      <nav class="card absolute top-12 right-0 flex min-w-56 flex-col p-2 shadow-pop" aria-label="Mobile navigation">
        {navigation.main.map((item) => (
          <a class="rounded-md px-3 py-2.5 text-[15px] text-ink-muted hover:bg-ground hover:text-ink" href={item.href}>{item.label}</a>
        ))}
        <a class="flex items-center gap-1.5 rounded-md px-3 py-2.5 text-[15px] text-ink-muted hover:bg-ground hover:text-ink" href={site.githubUrl}>GitHub <ExternalLink size={14} aria-hidden="true" /></a>
        <a class="rounded-md px-3 py-2.5 text-[15px] font-semibold text-primary hover:bg-ground" href="/docs/getting-started/">Get started</a>
      </nav>
    </details>
  </div>
</header>
