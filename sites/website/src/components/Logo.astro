---
interface Props { class?: string; }
const { class: className = "h-6" } = Astro.props;
---

<a class="inline-flex items-center" href="/" aria-label="Mica home">
  <picture>
    <source srcset="/brand/mica-wordmark-light.svg" media="(prefers-color-scheme: dark)" />
    <img src="/brand/mica-wordmark.svg" alt="" class:list={["w-auto", className]} />
  </picture>
</a>
